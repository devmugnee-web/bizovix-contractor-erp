{
  "name": "bizovix-contractor-erp",
  "private": true,
  "version": "1.0.0",
  "description": "Bizovix Contractor ERP - Desktop and SaaS ERP platform",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/start-local-dev.mjs",
    "dev:turbo": "turbo run dev --filter=@bizovix/api --filter=@bizovix/renderer",
    "dev:all": "turbo run dev",
    "dev:electron": "pnpm --filter @bizovix/electron dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @bizovix/api test:integration",
    "test:e2e": "pnpm --filter @bizovix/api test:e2e",
    "test:desktop": "node --test --test-isolation=none packages/desktop-storage/test/desktop-store.test.mjs packages/desktop-storage/test/masters.test.mjs packages/desktop-storage/test/organizations.test.mjs apps/desktop/local-service/test/local-service.test.mjs",
    "test:desktop:cloud": "node scripts/test-desktop-cloud.mjs",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @bizovix/database generate",
    "db:migrate": "pnpm --filter @bizovix/database migrate",
    "db:seed": "pnpm --filter @bizovix/database seed",
    "db:studio": "pnpm --filter @bizovix/database studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
