{
  "info": {
    "name": "Vendor Licensing API",
    "description": "Private Admin API (/vendor-admin/*) and Client Software API (/vendor-license/*) for the Bizovix Contractor ERP licensing/tracking system. Companion to VENDOR_LICENSING_API.md, which is the source of truth for every field/status code/error shape here. Run folders 1 through 10 top-to-bottom in order — each request saves the ids the next one needs into collection variables, so the whole collection executes as one coherent, working flow with zero forward-references.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "vendorAdminToken",
      "value": ""
    },
    {
      "key": "packageId",
      "value": ""
    },
    {
      "key": "oneTimePackageId",
      "value": ""
