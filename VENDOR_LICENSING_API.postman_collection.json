    {
      "key": "saasPackageId",
      "value": ""
    },
    {
      "key": "trialPackageId",
      "value": ""
    },
    {
      "key": "trialLicenseKey",
      "value": ""
    },
    {
      "key": "trialId",
      "value": ""
