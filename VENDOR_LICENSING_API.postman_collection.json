          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor-admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendor-admin",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@bizovix.com\",\n  \"password\": \"CHANGE_ME\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json().data;",
                  "if (data && data.accessToken !== undefined) pm.collectionVariables.set('vendorAdminToken', data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vendorAdminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor-admin/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendor-admin",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
