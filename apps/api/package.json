{
  "name": "@bizovix/api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:integration": "eslint \"test-integration/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:integration": "tsc --noEmit -p tsconfig.integration.json",
    "test": "jest",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "reconcile:legacy-financial": "nest build && dotenv -e ../../.env -- node dist/scripts/reconcile-legacy-financial-data.js",
    "cleanup:demo-banks": "nest build && dotenv -e ../../.env -- node dist/scripts/cleanup-demo-bank-data.js",
    "test:e2e": "node scripts/run-integration-tests.mjs --e2e"
  },
  "dependencies": {
    "@bizovix/database": "workspace:*",
    "@bizovix/types": "workspace:*",
    "@bizovix/utils": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@bizovix/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.17.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0"
  }
}
