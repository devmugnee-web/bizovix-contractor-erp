{
  "name": "@bizovix/electron",
  "private": true,
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "package": "pnpm build && node scripts/verify-package-inputs.cjs && electron-builder --config electron-builder.yml",
    "package:verify": "node scripts/verify-package-inputs.cjs",
    "package:verify-unpacked": "node scripts/verify-unpacked-resources.cjs",
    "test": "pnpm build && node --test test/*.test.cjs",
    "probe:runtime": "node scripts/probe-electron-runtime.cjs",
    "probe:renderer": "node scripts/probe-renderer-runtime.cjs",
    "probe:local-service": "node scripts/probe-local-service-runtime.cjs",
    "smoke:unpacked": "node scripts/smoke-unpacked-app.cjs",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bizovix/config": "workspace:*",
    "@types/node": "^22.10.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0"
  }
}
