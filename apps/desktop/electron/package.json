{
  "name": "@bizovix/electron",
  "private": true,
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "package": "pnpm build && electron-builder --config electron-builder.yml",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bizovix/config": "workspace:*",
    "@types/node": "^22.10.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0"
  }
}
