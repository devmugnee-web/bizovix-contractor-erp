  securityDepositMethod         String?
  securityDepositStatus         String?
  securityDepositReleasedAmount Decimal?  @db.Decimal(18, 2)
  securityDepositReleaseDueDate DateTime?
  securityDepositReleasedDate   DateTime?

  clientContactName String?
  responsiblePerson String?
  scopeOfWork       String?
  remarks           String?

  status      ContractStatus @default(DRAFT)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tender                 Tender?                 @relation(fields: [tenderId], references: [id])
  cmsWork                CmsWork                 @relation(fields: [cmsWorkId], references: [id])
  pgBgWorkflow           PgBgWorkflow?           @relation(fields: [pgBgWorkflowId], references: [id])
  organizationMaster     OrganizationMaster      @relation(fields: [organizationMasterId], references: [id])
  documents              Document[]
  bills                  ProjectBill[]
  challanSubmissions     ChallanSubmission[]
  vatTaxCertificates     VatTaxCertificate[]
  variationOrders        VariationOrder[]
  timeExtensions         TimeExtension[]
  receivables            Receivable[]
  completionCertificates CompletionCertificate[]
  defectLiabilityPeriods DefectLiabilityPeriod[]
  retentionReleases      RetentionRelease[]
  handovers              ProjectHandover[]

  @@unique([organizationId, contractNo])
  @@index([organizationId, status])
  @@index([organizationId, currentCompletionDate])
  @@index([organizationId, cmsWorkId])
  @@index([organizationId, securityDepositReleaseDueDate])
  @@map("project_contracts")
}

model ProjectBudget {
  id             String              @id @default(cuid())
  organizationId String
  cmsWorkId      String
  version        Int
  status         ProjectBudgetStatus @default(DRAFT)
  totalBudget    Decimal             @default(0) @db.Decimal(18, 2)
  revisionNote   String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cmsWork      CmsWork             @relation(fields: [cmsWorkId], references: [id])
  lines        ProjectBudgetLine[]

  @@unique([organizationId, cmsWorkId, version])
  @@index([organizationId, cmsWorkId, status])
  @@map("project_budgets")
}

model ProjectBudgetLine {
  id            String   @id @default(cuid())
  budgetId      String
  expenseHeadId String
  category      String
  description   String?
  amount        Decimal  @db.Decimal(18, 2)
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  budget      ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  expenseHead ExpenseHead   @relation(fields: [expenseHeadId], references: [id])

  @@index([budgetId])
  @@index([expenseHeadId])
  @@map("project_budget_lines")
}

model BoqSection {
  id             String   @id @default(cuid())
  organizationId String
  cmsWorkId      String
  name           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cmsWork      CmsWork      @relation(fields: [cmsWorkId], references: [id])
  items        BoqItem[]

  @@unique([cmsWorkId, name])
  @@map("boq_sections")
}

model BoqItem {
  id             String   @id @default(cuid())
  organizationId String
  cmsWorkId      String
  sectionId      String?
  itemCode       String?
  description    String
  unit           String
  /// Current approved quantity/rate/amount — the authoritative billing ceiling. Only ever
  /// changed via direct BOQ edit (pre-execution) or an approved VariationOrder (post-execution).
  contractQty    Decimal  @db.Decimal(18, 3)
  unitRate       Decimal  @db.Decimal(18, 2)
  contractAmount Decimal  @db.Decimal(18, 2)
  /// Immutable snapshot of contractQty/unitRate/contractAmount at item creation — never
  /// updated afterwards, so approved variations can be shown as a delta against the original.
  originalQty    Decimal  @db.Decimal(18, 3)
  originalRate   Decimal  @db.Decimal(18, 2)
  originalAmount Decimal  @db.Decimal(18, 2)
  executedQty    Decimal  @default(0) @db.Decimal(18, 3)
  executedValue  Decimal  @default(0) @db.Decimal(18, 2)
  specification  String?
  remarks        String?
  sortOrder      Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cmsWork                  CmsWork                   @relation(fields: [cmsWorkId], references: [id])
  section                  BoqSection?               @relation(fields: [sectionId], references: [id])
  billItems                ProjectBillItem[]
  variationItems           VariationItem[]
  purchaseRequisitionItems PurchaseRequisitionItem[]
  purchaseOrderItems       PurchaseOrderItem[]

  @@unique([cmsWorkId, itemCode])
  @@index([organizationId, cmsWorkId])
  @@map("boq_items")
}

// ---------------------------------------------------------------------------
// Running Bill / IPC + Retention + Variation Order + Time Extension
// ---------------------------------------------------------------------------

model ProjectBill {
  id             String @id @default(cuid())
  organizationId String
  cmsWorkId      String
  contractId     String

  billNo     String
  billType   BillType  @default(RUNNING)
  billDate   DateTime
  periodFrom DateTime?
  periodTo   DateTime?

  submissionDate       DateTime?
  certificationDate    DateTime?
  clientCertificateRef String?
  measurementBookRef   String?
  remarks              String?

  /// Sum of item currentValue (backend-calculated from BOQ qty x approved rate).
  grossWorkValue    Decimal @default(0) @db.Decimal(18, 2)
  /// Sum of BillAdjustment rows with direction=ADDITION.
  approvedAdditions Decimal @default(0) @db.Decimal(18, 2)
  /// grossWorkValue + approvedAdditions.
  grossBillAmount   Decimal @default(0) @db.Decimal(18, 2)

  /// Snapshotted at certification time — later DeductionConfig changes never retroactively
  /// change an already-certified bill.
  retentionPct            Decimal?  @db.Decimal(5, 2)
  retentionAmount         Decimal   @default(0) @db.Decimal(18, 2)
  retentionReleasedAmount Decimal   @default(0) @db.Decimal(18, 2)
  retentionReleaseDueDate DateTime?
  vatRate                 Decimal?  @db.Decimal(8, 4)
  vatAmount               Decimal   @default(0) @db.Decimal(18, 2)
  aitRate                 Decimal?  @db.Decimal(8, 4)
  aitAmount               Decimal   @default(0) @db.Decimal(18, 2)
  /// Sum of BillAdjustment rows with direction=DEDUCTION (advance recovery, other deductions).
  otherDeductionAmount    Decimal   @default(0) @db.Decimal(18, 2)

  netCertifiedAmount Decimal @default(0) @db.Decimal(18, 2)
  /// Denormalized cache kept in sync by Receipt allocation — authoritative value lives on Receivable.
  receivedAmount     Decimal @default(0) @db.Decimal(18, 2)

  status        BillStatus @default(DRAFT)
  createdById   String?
  submittedById String?
  certifiedById String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cmsWork      CmsWork           @relation(fields: [cmsWorkId], references: [id])
  contract     ProjectContract   @relation(fields: [contractId], references: [id])
  items        ProjectBillItem[]
  adjustments  BillAdjustment[]
  receivable   Receivable?
  documents    Document[]

  @@unique([organizationId, billNo])
  @@index([organizationId, cmsWorkId, status])
  @@index([organizationId, status])
  @@map("project_bills")
}

model ProjectBillItem {
  id        String @id @default(cuid())
  billId    String
  boqItemId String

  /// Snapshots of the BOQ item at billing time — historical bills stay reproducible even if
  /// the BOQ item is later edited or revised by a Variation.
  description  String
  unit         String
  approvedRate Decimal @db.Decimal(18, 2)
  contractQty  Decimal @db.Decimal(18, 3)

  previousQty     Decimal @db.Decimal(18, 3)
  currentQty      Decimal @db.Decimal(18, 3)
  cumulativeQty   Decimal @db.Decimal(18, 3)
  previousValue   Decimal @db.Decimal(18, 2)
  currentValue    Decimal @db.Decimal(18, 2)
  cumulativeValue Decimal @db.Decimal(18, 2)

  bill    ProjectBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  boqItem BoqItem     @relation(fields: [boqItemId], references: [id])

  @@unique([billId, boqItemId])
  @@index([boqItemId])
  @@map("project_bill_items")
}

model ChallanSubmission {
  id             String  @id @default(cuid())
  organizationId String
  cmsWorkId      String
  contractId     String?

  challanNo    String
  challanDate  DateTime
  description  String
  challanType  String
  challanMonth DateTime
  periodFrom   DateTime
  periodTo     DateTime

  receivedBy  String
  receivedAt  String
  submittedTo String
  paymentFrom String
  remarks     String?

  totalAmount    Decimal                 @default(0) @db.Decimal(18, 2)
  approvedAmount Decimal?                @db.Decimal(18, 2)
  status         ChallanSubmissionStatus @default(DRAFT)

  createdById         String?
  submittedAt         DateTime?
  submittedById       String?
  reviewStartedAt     DateTime?
  reviewStartedById   String?
  approvedAt          DateTime?
  approvedById        String?
  paymentReleasedAt   DateTime?
  paymentReleasedById String?
  rejectedAt          DateTime?
  rejectedById        String?
  rejectionReason     String?
  cancelledAt         DateTime?
  cancelledById       String?
  cancellationReason  String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization  Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cmsWork       CmsWork                          @relation(fields: [cmsWorkId], references: [id])
  contract      ProjectContract?                 @relation(fields: [contractId], references: [id])
  items         ChallanSubmissionItem[]
  statusHistory ChallanSubmissionStatusHistory[]
  documents     Document[]

  @@unique([organizationId, challanNo])
  @@index([organizationId, cmsWorkId, status])
  @@index([organizationId, status, challanDate])
  @@map("challan_submissions")
}

model ChallanSubmissionItem {
  id                  String   @id @default(cuid())
  organizationId      String
  challanSubmissionId String
  itemCode            String?
  description         String
  unit                String
  quantity            Decimal  @db.Decimal(18, 3)
  rate                Decimal  @db.Decimal(18, 2)
  amount              Decimal  @db.Decimal(18, 2)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  challanSubmission ChallanSubmission @relation(fields: [challanSubmissionId], references: [id], onDelete: Cascade)

  @@index([organizationId, challanSubmissionId])
  @@map("challan_submission_items")
}

model ChallanSubmissionStatusHistory {
  id                  String                   @id @default(cuid())
  organizationId      String
  challanSubmissionId String
  fromStatus          ChallanSubmissionStatus?
  toStatus            ChallanSubmissionStatus
  action              String
  note                String?
  actedById           String?
  createdAt           DateTime                 @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  challanSubmission ChallanSubmission @relation(fields: [challanSubmissionId], references: [id], onDelete: Cascade)

  @@index([organizationId, challanSubmissionId, createdAt])
  @@map("challan_submission_status_history")
}

model VatTaxCertificate {
  id               String                  @id @default(cuid())
  organizationId   String
  cmsWorkId        String
  contractId       String?
  certificateType  VatTaxCertificateType
  applicationDate  DateTime                @default(now())
  certificateNo    String?
  issueDate        DateTime?
  validTill        DateTime?
  amount           Decimal?                @db.Decimal(18, 2)
  issuingAuthority String?
  status           VatTaxCertificateStatus @default(PENDING)
  remarks          String?
  createdById      String?
  updatedById      String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cmsWork      CmsWork          @relation(fields: [cmsWorkId], references: [id])
  contract     ProjectContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  documents    Document[]

  // Case-insensitive uniqueness for non-null certificate numbers is enforced in SQL.
  @@index([organizationId, certificateType, certificateNo], map: "vat_tax_cert_org_type_no_idx")
  @@index([organizationId, cmsWorkId, status])
  @@index([organizationId, contractId])
  @@index([organizationId, certificateType, status])
  @@index([organizationId, applicationDate])
  @@index([organizationId, issueDate])
  @@index([organizationId, updatedAt])
  @@map("vat_tax_certificates")
}

model BillAdjustment {
  id          String              @id @default(cuid())
  billId      String
  /// Free string, not an enum — the exact set of adjustment kinds a company uses is
  /// configurable, not a fixed universal list. UI offers a suggested list.
  type        String
  direction   AdjustmentDirection
  description String?

  calculationType DeductionCalcType @default(FIXED_AMOUNT)
  rate            Decimal?          @db.Decimal(8, 4)
  baseAmount      Decimal?          @db.Decimal(18, 2)
  /// Backend-calculated authoritative amount — never trusted from the client as-is.
  amount          Decimal           @db.Decimal(18, 2)

  ledgerAccountId String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  bill          ProjectBill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])

  @@index([billId])
  @@map("bill_adjustments")
}

model Receivable {
  id             String  @id @default(cuid())
  organizationId String
  projectId      String
  contractId     String?
  projectBillId  String? @unique

  partyName      String
  billNo         String
  billDate       DateTime
  amount         Decimal   @default(0) @db.Decimal(18, 2)
  receivedAmount Decimal   @default(0) @db.Decimal(18, 2)
  dueDate        DateTime?
  description    String?
  status         String    @default("OUTSTANDING")
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      CmsWork          @relation(fields: [projectId], references: [id])
  contract     ProjectContract? @relation(fields: [contractId], references: [id])
  projectBill  ProjectBill?     @relation(fields: [projectBillId], references: [id])
  receipts     Receipt[]

  @@unique([organizationId, billNo])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, projectId])
  @@map("receivables")
}

model VariationOrder {
  id             String @id @default(cuid())
  organizationId String
  cmsWorkId      String
  contractId     String

  variationNo   String
  variationType VariationType @default(ADDITION)
  title         String
  reason        String
  description   String?
  requestDate   DateTime
  approvalDate  DateTime?

  requestedAmount Decimal  @db.Decimal(18, 2)
  approvedAmount  Decimal? @db.Decimal(18, 2)

  status       VariationStatus @default(DRAFT)
  createdById  String?
  approvedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cmsWork      CmsWork         @relation(fields: [cmsWorkId], references: [id])
  contract     ProjectContract @relation(fields: [contractId], references: [id])
  items        VariationItem[]
  documents    Document[]

  @@unique([organizationId, variationNo])
  @@index([organizationId, cmsWorkId, status])
  @@map("variation_orders")
}

model VariationItem {
  id               String  @id @default(cuid())
  variationOrderId String
  boqItemId        String?
  itemCode         String?
  description      String
  unit             String?

  /// Immutable snapshots of the BOQ item's state before this variation (null for a brand-new
  /// NEW_ITEM entry that has no prior BOQ row).
  originalQty  Decimal? @db.Decimal(18, 3)
  originalRate Decimal? @db.Decimal(18, 2)
  revisedQty   Decimal? @db.Decimal(18, 3)
  revisedRate  Decimal? @db.Decimal(18, 2)
  /// Backend-calculated net variation amount for this item.
  amount       Decimal  @db.Decimal(18, 2)

  variationOrder VariationOrder @relation(fields: [variationOrderId], references: [id], onDelete: Cascade)
  boqItem        BoqItem?       @relation(fields: [boqItemId], references: [id])

  @@map("variation_items")
}

model TimeExtension {
  id             String @id @default(cuid())
  organizationId String
  cmsWorkId      String
  contractId     String

  eotNo         String
  requestDate   DateTime
  requestedDays Int
  reason        String
  description   String?
  approvalDate  DateTime?
  approvedDays  Int?

  /// Immutable snapshots taken at request time — never overwritten by later EOTs.
  originalCompletionDate DateTime
  previousCompletionDate DateTime
  revisedCompletionDate  DateTime?

  status       TimeExtensionStatus @default(DRAFT)
  createdById  String?
  approvedById String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cmsWork      CmsWork         @relation(fields: [cmsWorkId], references: [id])
  contract     ProjectContract @relation(fields: [contractId], references: [id])
  documents    Document[]

  @@unique([organizationId, eotNo])
  @@index([organizationId, cmsWorkId, status])
  @@map("time_extensions")
}

model CompletionCertificate {
  id                      String                         @id @default(cuid())
  organizationId          String
  workId                  String
  contractId              String
  certificateNo           String
  completionType          String                         @default("FINAL")
  source                  CompletionCertificateSource    @default(UNSPECIFIED)
  egpStatus               CompletionCertificateEgpStatus @default(UNSPECIFIED)
  egpAppliedOn            DateTime?
  egpObtainedOn           DateTime?
  applicationDate         DateTime
  actualCompletionDate    DateTime
  certifiedCompletionDate DateTime?
  issuingAuthority        String?
  certificateDate         DateTime?
  remarks                 String?
  status                  CompletionCertificateStatus    @default(DRAFT)
  createdById             String?
  approvedById            String?
  approvedAt              DateTime?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  work         CmsWork                @relation(fields: [workId], references: [id])
  contract     ProjectContract        @relation(fields: [contractId], references: [id])
  dlp          DefectLiabilityPeriod?
  handovers    ProjectHandover[]
  documents    Document[]

  @@unique([organizationId, certificateNo])
  @@index([organizationId, workId, status])
  @@index([organizationId, source, egpStatus])
  // A partial unique index allows only one non-cancelled FINAL certificate per project.
  @@map("completion_certificates")
}

model DefectLiabilityPeriod {
  id                      String    @id @default(cuid())
  organizationId          String
  workId                  String
  contractId              String
  completionCertificateId String    @unique
  startDate               DateTime
  endDate                 DateTime
  originalStartDate       DateTime?
  originalEndDate         DateTime?
  durationDays            Int
  status                  DlpStatus @default(NOT_STARTED)
  remarks                 String?
  createdById             String?
  completedById           String?
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  work                  CmsWork               @relation(fields: [workId], references: [id])
  contract              ProjectContract       @relation(fields: [contractId], references: [id])
  completionCertificate CompletionCertificate @relation(fields: [completionCertificateId], references: [id])
  extensions            DlpExtension[]
  defects               DlpDefect[]
  documents             Document[]

  @@index([organizationId, status, endDate])
  @@index([organizationId, workId])
  @@map("defect_liability_periods")
}

model DlpExtension {
  id              String                @id @default(cuid())
  dlpId           String
  previousEndDate DateTime
  revisedEndDate  DateTime
  extensionDays   Int
  reason          String
  approvedById    String
  approvedAt      DateTime              @default(now())
  createdAt       DateTime              @default(now())
  dlp             DefectLiabilityPeriod @relation(fields: [dlpId], references: [id], onDelete: Cascade)

  @@index([dlpId])
  @@map("dlp_extensions")
}

model DlpDefect {
