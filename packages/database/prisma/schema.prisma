  ourCost                Decimal             @default(0) @db.Decimal(18, 2)
  marginPercent          Decimal             @default(0) @db.Decimal(7, 4)
  freightCost            Decimal             @default(0) @db.Decimal(18, 2)
  installationCost       Decimal             @default(0) @db.Decimal(18, 2)
  otherCost              Decimal             @default(0) @db.Decimal(18, 2)
