model WorkIou {
  id                     String                  @id @default(cuid())
  organizationId         String
  iouNo                  String
  iouDate                DateTime
  paidOn                 DateTime
  paidById               String
  paidToName             String
  paymentMethod          WorkIouPaymentMethod
  referenceNo            String?
  expenseFor             WorkIouExpenseFor
  tenderId               String?
  workId                 String?
  purpose                String
  remarks                String?
  otherCharges           Decimal                 @default(0) @db.Decimal(18, 2)
  subtotal               Decimal                 @default(0) @db.Decimal(18, 2)
  discount               Decimal                 @default(0) @db.Decimal(18, 2)
  totalAmount            Decimal                 @default(0) @db.Decimal(18, 2)
  settledAmount          Decimal                 @default(0) @db.Decimal(18, 2)
  settlementStatus       WorkIouSettlementStatus @default(PENDING)
  expectedSettlementDate DateTime?
  settlementRemarks      String?
  status                 WorkIouStatus           @default(DRAFT)
  version                Int                     @default(1)
  submittedAt            DateTime?
  submittedById          String?
  cancelledAt            DateTime?
  cancelledById          String?
  cancellationReason     String?
  createdById            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paidBy       User                @relation("WorkIouPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  tender       Tender?             @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict)
  work         CmsWork?            @relation(fields: [organizationId, workId], references: [organizationId, id], onDelete: Restrict)
  submittedBy  User?               @relation("WorkIouSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  cancelledBy  User?               @relation("WorkIouCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdBy    User?               @relation("WorkIouCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        WorkIouItem[]
  attachments  WorkIouAttachment[]

  @@unique([organizationId, id])
  @@unique([organizationId, iouNo])
  @@index([organizationId, status, iouDate])
  @@index([organizationId, expenseFor, tenderId])
  @@index([organizationId, expenseFor, workId])
  @@index([organizationId, paidById])
  @@index([organizationId, settlementStatus, expectedSettlementDate], map: "work_ious_org_settlement_expected_idx")
  @@map("work_ious")
}

model WorkIouItem {
  id             String   @id @default(cuid())
  organizationId String
  workIouId      String
  expenseDate    DateTime
  description    String
  expenseHeadId  String
  categoryName   String
  paidToName     String
  referenceNo    String?
  amount         Decimal  @db.Decimal(18, 2)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workIou      WorkIou      @relation(fields: [organizationId, workIouId], references: [organizationId, id], onDelete: Cascade)
  expenseHead  ExpenseHead  @relation(fields: [organizationId, expenseHeadId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, workIouId, sortOrder])
  @@index([organizationId, expenseHeadId])
  @@map("work_iou_items")
}

model WorkIouAttachment {
  id             String   @id @default(cuid())
  organizationId String
  workIouId      String
  fileName       String
  mimeType       String
  fileSize       Int
  data           Bytes
  uploadedById   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workIou      WorkIou      @relation(fields: [organizationId, workIouId], references: [organizationId, id], onDelete: Cascade)
  uploadedBy   User?        @relation("WorkIouAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, workIouId])
  @@map("work_iou_attachments")
}

model Receipt {
  id                  String        @id @default(cuid())
  organizationId      String
  tenderId            String?
  workId              String?
  receiptNo           String?
  receiptCategory     String        @default("GENERAL")
  receiptType         String        @default("GENERAL_RECEIPT")
  receivedFrom        String        @default("Unknown")
  receivedInAccountId String?
  paymentMethod       String        @default("CASH")
  referenceNo         String?
  description         String?
  amount              Decimal       @db.Decimal(18, 2)
  receiptDate         DateTime
  dueDate             DateTime?
  status              ReceiptStatus @default(PENDING)
  /// Optional link to a specific Receivable (usually from a certified ProjectBill) this
  /// receipt is allocated against — enables per-bill outstanding tracking and over-receipt
  /// prevention instead of only a loose project-level total.
  receivableId        String?
  createdById         String?
  cancelledAt         DateTime?
  cancelledById       String?
  cancellationReason  String?
  replacesReceiptId   String?       @unique
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tender            Tender?      @relation(fields: [tenderId], references: [id])
  work              CmsWork?     @relation(fields: [workId], references: [id])
  receivedInAccount BankAccount? @relation(fields: [receivedInAccountId], references: [id])
  receivable        Receivable?  @relation(fields: [receivableId], references: [id])
  replaces          Receipt?     @relation("ReceiptAmendment", fields: [replacesReceiptId], references: [id])
  replacement       Receipt?     @relation("ReceiptAmendment")

  @@unique([organizationId, receiptNo])
  @@index([organizationId, receiptDate])
  @@index([organizationId, workId])
  @@index([organizationId, status])
  @@index([organizationId, replacesReceiptId])
  @@map("receipts")
}

model ReceiptSequence {
  id             String @id @default(cuid())
  organizationId String
  year           Int
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year])
  @@map("receipt_sequences")
}

model FinancialTransaction {
  id              String   @id @default(cuid())
  organizationId  String
  transactionNo   String
  accountId       String
  direction       String
  amount          Decimal  @db.Decimal(18, 2)
  balanceAfter    Decimal  @db.Decimal(18, 2)
  sourceModule    String
  sourceType      String
  sourceId        String
  referenceNo     String?
  description     String
  transactionDate DateTime
  status          String   @default("POSTED")
  createdById     String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      BankAccount  @relation(fields: [accountId], references: [id])

  @@unique([organizationId, transactionNo])
  @@unique([organizationId, sourceModule, sourceType, sourceId, accountId, direction])
  @@index([organizationId, transactionDate])
  @@index([organizationId, accountId, transactionDate])
  @@map("financial_transactions")
}

model FundTransfer {
  id             String   @id @default(cuid())
  organizationId String
  transferNo     String
  fromAccountId  String
  toAccountId    String
  amount         Decimal  @db.Decimal(18, 2)
  bankCharge     Decimal  @default(0) @db.Decimal(18, 2)
  referenceNo    String?
  description    String?
  transferDate   DateTime
  status         String   @default("COMPLETED")
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromAccount  BankAccount  @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount    BankAccount  @relation("TransferTo", fields: [toAccountId], references: [id])

  @@unique([organizationId, transferNo])
  @@index([organizationId, transferDate])
  @@map("fund_transfers")
