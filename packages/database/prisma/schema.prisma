  @@index([organizationId, type, isActive])
  @@map("deduction_configs")
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Expense {
  id                     String             @id @default(cuid())
  organizationId         String
  workId                 String?
  expenseHeadId          String?
  expenseById            String?
  paidFromAccountId      String?
  expenseLedgerAccountId String?
  payablePartyId         String?
  payableId              String?            @unique
  category               String?
  expenseNature          ExpenseNature      @default(INDIRECT)
  paymentMode            ExpensePaymentMode @default(CASH_BANK)
  description            String?
  amount                 Decimal            @db.Decimal(18, 2)
  expenseDate            DateTime
  dueDate                DateTime?
  status                 ExpenseStatus      @default(PENDING)
  referenceNo            String?
  approvedById           String?
  createdById            String?
  cancelledAt            DateTime?
  cancelledById          String?
  cancellationReason     String?
  replacesExpenseId      String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  work            CmsWork?            @relation(fields: [workId], references: [id])
  expenseHead     ExpenseHead?        @relation(fields: [expenseHeadId], references: [id])
  expenseBy       User?               @relation("ExpenseThrough", fields: [expenseById], references: [id])
  paidFromAccount BankAccount?        @relation(fields: [paidFromAccountId], references: [id])
  expenseLedger   LedgerAccount?      @relation(fields: [expenseLedgerAccountId], references: [id])
  payableParty    Party?              @relation(fields: [payablePartyId], references: [id])
  payable         Payable?            @relation(fields: [payableId], references: [id])
  attachments     ExpenseAttachment[]
  replaces        Expense?            @relation("ExpenseAmendment", fields: [replacesExpenseId], references: [id])
  replacement     Expense?            @relation("ExpenseAmendment")

  @@unique([organizationId, referenceNo])
  @@index([organizationId, workId, expenseDate])
  @@index([organizationId, expenseHeadId])
  @@index([organizationId, status])
  @@index([organizationId, expenseLedgerAccountId])
  @@index([organizationId, payablePartyId])
  @@index([organizationId, replacesExpenseId])
  @@map("expenses")
}

model ExpenseAttachment {
