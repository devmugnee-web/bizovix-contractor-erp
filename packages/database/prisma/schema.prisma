model BankReconciliation {
  id               String    @id @default(cuid())
  organizationId   String
  accountId        String
  statementFrom    DateTime
  statementTo      DateTime
  erpBalance       Decimal   @db.Decimal(18, 2)
  statementBalance Decimal   @db.Decimal(18, 2)
  difference       Decimal   @db.Decimal(18, 2)
  status           String    @default("IN_PROGRESS")
  reconciledById   String?
  reconciledAt     DateTime?
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      BankAccount  @relation(fields: [accountId], references: [id])

  @@index([organizationId, accountId, statementTo])
  @@map("bank_reconciliations")
}

model Cheque {
  id             String    @id @default(cuid())
  organizationId String
  chequeNo       String
  type           String
  accountId      String?
  bankName       String
  branch         String?
  party          String
  amount         Decimal   @db.Decimal(18, 2)
  chequeDate     DateTime
  actionDate     DateTime?
  referenceNo    String?
  status         String    @default("PENDING")
  remarks        String?
  postedAt       DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      BankAccount? @relation(fields: [accountId], references: [id])

  @@unique([organizationId, chequeNo, type])
  @@index([organizationId, status, chequeDate])
  @@map("cheques")
}

model LedgerAccount {
  id                  String   @id @default(cuid())
  organizationId      String
  code                String
  name                String
  parentId            String?
  accountType         String
  normalBalance       String
  description         String?
  isActive            Boolean  @default(true)
  isSystem            Boolean  @default(false)
  /// Control accounts (AR/AP/Cash/Bank/Opening-Equity) cannot be posted to directly by an
  /// ordinary manual journal entry — see AccountingService.assertNotControlAccount().
  isControlAccount    Boolean  @default(false)
  systemKey           String?
  linkedBankAccountId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization                             Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent                                   LedgerAccount?   @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                                 LedgerAccount[]  @relation("AccountHierarchy")
  bankAccount                              BankAccount?     @relation(fields: [linkedBankAccountId], references: [id])
  journalLines                             JournalLine[]
  billAdjustments                          BillAdjustment[]
  expenses                                 Expense[]
  expenseHeads                             ExpenseHead[]
  assetCategoriesByAssetLedger             AssetCategory[]  @relation("AssetCategoryAssetLedger")
  assetCategoriesByAccumulatedDepreciation AssetCategory[]  @relation("AssetCategoryAccumulatedDepreciationLedger")
  assetCategoriesByDepreciationExpense     AssetCategory[]  @relation("AssetCategoryDepreciationExpenseLedger")
  fixedAssets                              FixedAsset[]     @relation("FixedAssetLedger")
  lcCostHeads                              LcCostHead[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
  @@unique([organizationId, linkedBankAccountId])
  @@index([organizationId, accountType, isActive])
  @@map("ledger_accounts")
}

model JournalEntry {
  id             String    @id @default(cuid())
  organizationId String
  journalNo      String
  journalDate    DateTime
  referenceNo    String?
  description    String
  sourceModule   String
  sourceType     String
  sourceId       String
  status         String    @default("DRAFT")
  reversalOfId   String?
  createdById    String?
  postedById     String?
  postedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines             JournalLine[]
  reversalOf        JournalEntry?      @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversals         JournalEntry[]     @relation("JournalReversal")
  retentionReleases RetentionRelease[]

  @@unique([organizationId, journalNo])
  @@unique([organizationId, sourceModule, sourceType, sourceId])
  @@index([organizationId, journalDate, status])
  @@index([organizationId, sourceModule, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  projectId      String?
  partyName      String?
  partyType      String?
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  description    String?
  createdAt      DateTime @default(now())

  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      LedgerAccount @relation(fields: [accountId], references: [id])
  project      CmsWork?      @relation(fields: [projectId], references: [id])

  @@index([accountId, journalEntryId])
  @@index([projectId, journalEntryId])
  @@index([partyName, journalEntryId])
  @@map("journal_lines")
}

model Payable {
  id             String    @id @default(cuid())
  organizationId String
  /// Additive, nullable — new Payables may link a real Party; historical free-text
  /// partyName rows stay unlinked rather than being guessed at (see migration notes).
  partyId        String?
  partyName      String
  partyType      String    @default("VENDOR")
  projectId      String?
  billNo         String
  billDate       DateTime
  amount         Decimal   @db.Decimal(18, 2)
  paidAmount     Decimal   @default(0) @db.Decimal(18, 2)
  dueDate        DateTime?
  description    String?
  status         String    @default("UNPAID")
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          CmsWork?          @relation(fields: [projectId], references: [id])
  party            Party?            @relation(fields: [partyId], references: [id])
  /// Opposite side of SupplierBill.payableId — present only for Payables created by an
  /// approved Supplier Bill; historical/manual Payables (CMS, Tender, generic AP entry) have none.
  supplierBill     SupplierBill?
  supplierPayments SupplierPayment[]
  expense          Expense?
  lcPurchase       LcMaster?         @relation("LcPurchasePayable")
  lcCostEntry      LcCostEntry?      @relation("LcCostPayable")

  @@unique([organizationId, billNo])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, partyName])
  @@index([organizationId, partyId])
  @@map("payables")
}

