// ---------------------------------------------------------------------------
// Masters — Vendor / Supplier / Subcontractor / Item Foundation
// ---------------------------------------------------------------------------

enum PartyRole {
  CLIENT
  VENDOR
  SUPPLIER
  SUBCONTRACTOR
  SERVICE_PROVIDER
  OTHER
}

enum PartyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
  ARCHIVED
}

enum MasterCategoryType {
  VENDOR
  MATERIAL
  SUBCONTRACTOR_TRADE
  DOCUMENT_PURCHASE
}

enum ItemType {
  MATERIAL
  SERVICE
  EQUIPMENT
  CONSUMABLE
  OTHER
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}

/// A commercial party this organization deals with on the pay-out side (vendor, supplier,
/// subcontractor, service provider). Deliberately unified rather than one model per role —
/// one company can carry multiple roles (e.g. Supplier + Subcontractor) via `roles`, matching
/// the client's own explicit "avoid duplicate records per role" instruction. This is distinct
/// from OrganizationMaster, which models the opposite party (who this org tenders/contracts TO).
model Party {
  id             String      @id @default(cuid())
  organizationId String
  code           String
  name           String
  displayName    String?
  roles          PartyRole[]
  status         PartyStatus @default(ACTIVE)

  contactPerson  String?
  phone          String?
  alternatePhone String?
  email          String?
  website        String?

  address  String?
  district String?
  country  String?

  binVat         String?
  tinNo          String?
  tradeLicenseNo String?
  registrationNo String?

  bankName         String?
  bankAccountName  String?
  bankAccountNo    String?
  bankBranch       String?
  bankRoutingSwift String?

  paymentTermId   String?
  defaultCurrency String?  @default("BDT")
  creditLimit     Decimal? @db.Decimal(18, 2)

  categoryId String?

  notes String?

  createdById  String?
  archivedAt   DateTime?
  archivedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization                Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentTerm                 PaymentTerm?                   @relation(fields: [paymentTermId], references: [id])
  category                    MasterCategory?                @relation(fields: [categoryId], references: [id])
  subcontractorProfile        SubcontractorProfile?
  contacts                    OrganizationContact[]
  payables                    Payable[]
  documents                   Document[]
  preferredForItems           Item[]                         @relation("PreferredVendor")
  rfqInvitations              RfqSupplier[]
  supplierQuotations          SupplierQuotation[]
  comparativeStatementEntries ComparativeStatementSupplier[]
  purchaseOrders              PurchaseOrder[]
  goodsReceiptNotes           GoodsReceiptNote[]
  supplierBills               SupplierBill[]
  supplierPayments            SupplierPayment[]
  fixedAssets                 FixedAsset[]
  lcMasters                   LcMaster[]
  payableExpenses             Expense[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@map("parties")
}

/// 1:1 extension of Party, present only when a party carries the SUBCONTRACTOR role — keeps
/// the base Party table lean for the common vendor/supplier case while still supporting
/// subcontractor-specific fields. VAT/AIT rates deliberately are NOT duplicated here: they
/// come from the existing org-level effective-dated DeductionConfig, never a hardcoded or
/// per-party override, per the "use existing configuration architecture" instruction.
model SubcontractorProfile {
  id                  String   @id @default(cuid())
  organizationId      String
  partyId             String   @unique
  tradeCategoryId     String?
  specialization      String?
  defaultRetentionPct Decimal? @db.Decimal(5, 2)
  performanceRating   Decimal? @db.Decimal(3, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  party         Party           @relation(fields: [partyId], references: [id], onDelete: Cascade)
  tradeCategory MasterCategory? @relation(fields: [tradeCategoryId], references: [id])

  @@map("subcontractor_profiles")
}

/// One typed, reusable category master (discriminated by `type`) instead of three separate
/// category tables — avoids both a generic over-engineered category engine and duplicate
/// per-domain category models.
model MasterCategory {
  id             String             @id @default(cuid())
  organizationId String
  type           MasterCategoryType
  name           String
  description    String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parties               Party[]
  subcontractorProfiles SubcontractorProfile[]
  items                 Item[]

  @@unique([organizationId, type, name])
  @@map("master_categories")
}

model UnitOfMeasurement {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  symbol         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items                    Item[]
  purchaseRequisitionItems PurchaseRequisitionItem[]

  @@unique([organizationId, code])
  @@map("units_of_measurement")
}

model PaymentTerm {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  days           Int      @default(0)
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parties        Party[]
  supplierBills  SupplierBill[]
  tenderCostings TenderCosting[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("payment_terms")
}

/// Master data only — no stock/quantity-on-hand fields. Deliberately shaped so future
/// Procurement (RFQ/PO/GRN) and Inventory phases can layer on top without a redesign.
model Item {
  id                  String     @id @default(cuid())
  organizationId      String
  itemCode            String
  itemName            String
  description         String?
  itemType            ItemType   @default(MATERIAL)
  categoryId          String?
  uomId               String?
  defaultPurchaseRate Decimal?   @db.Decimal(18, 2)
  preferredVendorId   String?
  specification       String?
  brandModel          String?
  status              ItemStatus @default(ACTIVE)
  createdById         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category                 MasterCategory?           @relation(fields: [categoryId], references: [id])
  uom                      UnitOfMeasurement?        @relation(fields: [uomId], references: [id])
  preferredVendor          Party?                    @relation("PreferredVendor", fields: [preferredVendorId], references: [id])
  purchaseRequisitionItems PurchaseRequisitionItem[]
  rfqItems                 RfqItem[]
  purchaseOrderItems       PurchaseOrderItem[]
  supplierBillItems        SupplierBillItem[]
  lcItems                  LcItem[]
  stockMovements           StockMovement[]

  @@unique([organizationId, itemCode])
  @@index([organizationId, status])
  @@map("items")
}

// ---------------------------------------------------------------------------
// Procurement Core — PR / RFQ / Supplier Quotation / Comparative Statement / PO / GRN
// ---------------------------------------------------------------------------

enum PrPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PrStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED
}

enum RfqStatus {
  DRAFT
  ISSUED
  CLOSED
  CANCELLED
  AWARDED
}

enum QuotationStatus {
  RECEIVED
  SUPERSEDED
  WITHDRAWN
}

enum TechnicalComplianceStatus {
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
}

enum ComparativeStatementStatus {
  DRAFT
  EVALUATED
  APPROVED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

/// PENDING is reachable only by a future two-step inspection workflow — the current
/// single-step GRN creation always computes ACCEPTED/PARTIAL/REJECTED immediately from the
/// entered accepted/rejected/damaged quantities (see grn-calculations.ts).
enum GrnInspectionStatus {
  PENDING
  ACCEPTED
  PARTIAL
  REJECTED
}

enum SupplierBillStatus {
  DRAFT
  APPROVAL_PENDING
  APPROVED
  PARTIALLY_PAID
  PAID
  REJECTED
  CANCELLED
}

/// Per-item and overall 3-way-match outcome (PO vs GRN vs Supplier Bill). MISSING_RECEIPT and
/// BLOCKED are hard stops that prevent approval; QUANTITY_VARIANCE/RATE_VARIANCE/AMOUNT_VARIANCE
/// are informational — visible on the bill, but do not by themselves block approval.
enum BillMatchStatus {
  MATCHED
  QUANTITY_VARIANCE
  RATE_VARIANCE
  AMOUNT_VARIANCE
  MISSING_RECEIPT
  BLOCKED
}

enum SupplierPaymentStatus {
  ACTIVE
  CANCELLED
}

model PurchaseRequisition {
  id             String     @id @default(cuid())
  organizationId String
  prNo           String
  requestDate    DateTime
  requiredByDate DateTime?
  cmsWorkId      String?
  department     String?
  requestedById  String?
  priority       PrPriority @default(MEDIUM)
  purpose        String?
  remarks        String?
  status         PrStatus   @default(DRAFT)
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cmsWork        CmsWork?                  @relation(fields: [cmsWorkId], references: [id])
  items          PurchaseRequisitionItem[]
  rfqs           RequestForQuotation[]
  purchaseOrders PurchaseOrder[]
  documents      Document[]

  @@unique([organizationId, prNo])
  @@index([organizationId, status])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id                    String    @id @default(cuid())
  organizationId        String
  purchaseRequisitionId String
  itemId                String
  descriptionSnapshot   String
  uomId                 String?
  requestedQty          Decimal   @db.Decimal(18, 3)
  estimatedRate         Decimal?  @db.Decimal(18, 2)
  estimatedAmount       Decimal?  @db.Decimal(18, 2)
  requiredDate          DateTime?
  boqItemId             String?
  remarks               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseRequisition PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id], onDelete: Cascade)
  item                Item                @relation(fields: [itemId], references: [id])
  uom                 UnitOfMeasurement?  @relation(fields: [uomId], references: [id])
  boqItem             BoqItem?            @relation(fields: [boqItemId], references: [id])
  rfqItems            RfqItem[]

  @@index([organizationId, purchaseRequisitionId])
  @@map("purchase_requisition_items")
}

model RequestForQuotation {
  id                    String    @id @default(cuid())
  organizationId        String
  rfqNo                 String
  purchaseRequisitionId String?
  cmsWorkId             String?
  issueDate             DateTime
  submissionDeadline    DateTime
  deliveryLocation      String?
  termsConditions       String?
  paymentTerms          String?
  remarks               String?
  status                RfqStatus @default(DRAFT)
  issuedById            String?
  issuedAt              DateTime?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseRequisition  PurchaseRequisition?  @relation(fields: [purchaseRequisitionId], references: [id])
  cmsWork              CmsWork?              @relation(fields: [cmsWorkId], references: [id])
  suppliers            RfqSupplier[]
  items                RfqItem[]
  quotations           SupplierQuotation[]
  comparativeStatement ComparativeStatement?
  purchaseOrders       PurchaseOrder[]
  documents            Document[]

  @@unique([organizationId, rfqNo])
  @@index([organizationId, status])
  @@map("request_for_quotations")
}

model RfqSupplier {
  id             String   @id @default(cuid())
  organizationId String
  rfqId          String
  supplierId     String
  invitedAt      DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfq          RequestForQuotation @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier     Party               @relation(fields: [supplierId], references: [id])

  @@unique([rfqId, supplierId])
  @@map("rfq_suppliers")
}

/// Snapshotted item detail so later edits to the Item master never change what an already-
/// issued RFQ historically asked suppliers to quote against.
model RfqItem {
  id                        String   @id @default(cuid())
  organizationId            String
  rfqId                     String
  itemId                    String
  purchaseRequisitionItemId String?
  itemCodeSnapshot          String
  itemNameSnapshot          String
  descriptionSnapshot       String?
  unitSnapshot              String
  requestedQty              Decimal  @db.Decimal(18, 3)
  remarks                   String?
  createdAt                 DateTime @default(now())

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfq                     RequestForQuotation      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  item                    Item                     @relation(fields: [itemId], references: [id])
  purchaseRequisitionItem PurchaseRequisitionItem? @relation(fields: [purchaseRequisitionItemId], references: [id])
  quotationItems          SupplierQuotationItem[]

  @@index([organizationId, rfqId])
  @@map("rfq_items")
}

model SupplierQuotation {
  id                 String          @id @default(cuid())
  organizationId     String
  rfqId              String
  supplierId         String
  quotationRef       String
  quotationDate      DateTime
  validityDate       DateTime?
  currency           String          @default("BDT")
  deliveryDays       Int?
  paymentTerms       String?
  warranty           String?
  remarks            String?
  status             QuotationStatus @default(RECEIVED)
  revisionNo         Int             @default(1)
  previousRevisionId String?         @unique
  totalAmount        Decimal         @db.Decimal(18, 2)
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization                  Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfq                           RequestForQuotation            @relation(fields: [rfqId], references: [id])
  supplier                      Party                          @relation(fields: [supplierId], references: [id])
  previousRevision              SupplierQuotation?             @relation("QuotationRevision", fields: [previousRevisionId], references: [id])
  nextRevision                  SupplierQuotation?             @relation("QuotationRevision")
  items                         SupplierQuotationItem[]
  comparativeStatementSuppliers ComparativeStatementSupplier[]
  documents                     Document[]

  @@unique([rfqId, supplierId, quotationRef, revisionNo])
  @@index([organizationId, rfqId, status])
  @@map("supplier_quotations")
}

model SupplierQuotationItem {
  id             String  @id @default(cuid())
  organizationId String
  quotationId    String
  rfqItemId      String
  offeredQty     Decimal @db.Decimal(18, 3)
  unitRate       Decimal @db.Decimal(18, 2)
  discountPct    Decimal @default(0) @db.Decimal(5, 2)
  taxPct         Decimal @default(0) @db.Decimal(5, 2)
  lineAmount     Decimal @db.Decimal(18, 2)
  deliveryDays   Int?
  brandModel     String?
  specification  String?
  remarks        String?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItem      RfqItem           @relation(fields: [rfqItemId], references: [id])

  @@index([organizationId, quotationId])
  @@map("supplier_quotation_items")
}

/// One CS per RFQ, single-supplier-award model (deliberately practical, not a full split-award
/// engine — see master task's own "keep initial architecture practical" instruction). Per-item
/// comparison (which supplier is cheapest on which line) is computed at read time by joining
/// RfqItem + SupplierQuotationItem; only the supplier-level evaluation outcome is persisted here.
model ComparativeStatement {
  id             String                     @id @default(cuid())
  organizationId String
  rfqId          String                     @unique
  cmsWorkId      String?
  csNo           String
  status         ComparativeStatementStatus @default(DRAFT)
  decisionNotes  String?
  preparedById   String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfq            RequestForQuotation            @relation(fields: [rfqId], references: [id])
  cmsWork        CmsWork?                       @relation(fields: [cmsWorkId], references: [id])
  suppliers      ComparativeStatementSupplier[]
  purchaseOrders PurchaseOrder[]
  documents      Document[]

  @@unique([organizationId, csNo])
  @@map("comparative_statements")
}

model ComparativeStatementSupplier {
  id                     String                    @id @default(cuid())
  organizationId         String
  comparativeStatementId String
  supplierId             String
  quotationId            String
  quotedTotal            Decimal                   @db.Decimal(18, 2)
  commercialAdjustment   Decimal                   @default(0) @db.Decimal(18, 2)
  evaluatedTotal         Decimal                   @db.Decimal(18, 2)
  deliveryDays           Int?
  paymentTerms           String?
  technicalStatus        TechnicalComplianceStatus @default(COMPLIANT)
  recommended            Boolean                   @default(false)
  rank                   Int?
  isSelected             Boolean                   @default(false)
  remarks                String?

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comparativeStatement ComparativeStatement @relation(fields: [comparativeStatementId], references: [id], onDelete: Cascade)
  supplier             Party                @relation(fields: [supplierId], references: [id])
  quotation            SupplierQuotation    @relation(fields: [quotationId], references: [id])

  @@unique([comparativeStatementId, supplierId])
  @@map("comparative_statement_suppliers")
}

model PurchaseOrder {
  id                     String              @id @default(cuid())
  organizationId         String
  poNo                   String
  poDate                 DateTime
  supplierId             String
  cmsWorkId              String?
  purchaseRequisitionId  String?
  rfqId                  String?
  comparativeStatementId String?
  deliveryAddress        String?
  paymentTerms           String?
  deliveryTerms          String?
  currency               String              @default("BDT")
  subtotal               Decimal             @db.Decimal(18, 2)
  discountAmount         Decimal             @default(0) @db.Decimal(18, 2)
  taxAmount              Decimal             @default(0) @db.Decimal(18, 2)
  otherCharges           Decimal             @default(0) @db.Decimal(18, 2)
  grandTotal             Decimal             @db.Decimal(18, 2)
  remarks                String?
  status                 PurchaseOrderStatus @default(DRAFT)
  createdById            String?
  approvedById           String?
  approvedAt             DateTime?
  issuedAt               DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier             Party                 @relation(fields: [supplierId], references: [id])
  cmsWork              CmsWork?              @relation(fields: [cmsWorkId], references: [id])
  purchaseRequisition  PurchaseRequisition?  @relation(fields: [purchaseRequisitionId], references: [id])
  rfq                  RequestForQuotation?  @relation(fields: [rfqId], references: [id])
  comparativeStatement ComparativeStatement? @relation(fields: [comparativeStatementId], references: [id])
  items                PurchaseOrderItem[]
  goodsReceiptNotes    GoodsReceiptNote[]
  documents            Document[]
  supplierBills        SupplierBill[]

  @@unique([organizationId, poNo])
  @@index([organizationId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                    String    @id @default(cuid())
  organizationId        String
  purchaseOrderId       String
  itemId                String
  itemCodeSnapshot      String
  itemNameSnapshot      String
  descriptionSnapshot   String?
  unitSnapshot          String
  orderedQty            Decimal   @db.Decimal(18, 3)
  unitRate              Decimal   @db.Decimal(18, 2)
  discountAmount        Decimal   @default(0) @db.Decimal(18, 2)
  netRate               Decimal   @db.Decimal(18, 2)
  lineAmount            Decimal   @db.Decimal(18, 2)
  /// Running cumulative total across all GRNs against this line — updated transactionally at
  /// GRN creation, mirroring the BoqItem.executedQty ceiling-tracking pattern.
  receivedQty           Decimal   @default(0) @db.Decimal(18, 3)
  /// Running cumulative total across all APPROVED Supplier Bills against this line — updated
  /// transactionally at bill approval only, mirroring receivedQty's ceiling-tracking pattern.
  billedQty             Decimal   @default(0) @db.Decimal(18, 3)
  deliveryDate          DateTime?
  cmsWorkId             String?
  boqItemId             String?
  sourceQuotationItemId String?
  remarks               String?

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item              Item               @relation(fields: [itemId], references: [id])
  cmsWork           CmsWork?           @relation(fields: [cmsWorkId], references: [id])
  boqItem           BoqItem?           @relation(fields: [boqItemId], references: [id])
  grnItems          GrnItem[]
  supplierBillItems SupplierBillItem[]

  @@index([organizationId, purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceiptNote {
  id                  String              @id @default(cuid())
  organizationId      String
  grnNo               String
  purchaseOrderId     String
  supplierId          String
  cmsWorkId           String?
  receiptDate         DateTime
  deliveryChallanNo   String?
  deliveryChallanDate DateTime?
  receivedById        String?
  inspectionStatus    GrnInspectionStatus @default(PENDING)
  warehouseLocation   String?
  remarks             String?
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplier      Party         @relation(fields: [supplierId], references: [id])
  cmsWork       CmsWork?      @relation(fields: [cmsWorkId], references: [id])
  items         GrnItem[]
  documents     Document[]

  @@unique([organizationId, grnNo])
  @@index([organizationId, purchaseOrderId])
  @@map("goods_receipt_notes")
}

model GrnItem {
  id                    String  @id @default(cuid())
  organizationId        String
  grnId                 String
  purchaseOrderItemId   String
  descriptionSnapshot   String
  unitSnapshot          String
  orderedQty            Decimal @db.Decimal(18, 3)
  previouslyReceivedQty Decimal @db.Decimal(18, 3)
  currentReceivedQty    Decimal @db.Decimal(18, 3)
  cumulativeReceivedQty Decimal @db.Decimal(18, 3)
  remainingQty          Decimal @db.Decimal(18, 3)
  acceptedQty           Decimal @db.Decimal(18, 3)
  rejectedQty           Decimal @default(0) @db.Decimal(18, 3)
  damagedQty            Decimal @default(0) @db.Decimal(18, 3)
  inspectionRemarks     String?

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grn               GoodsReceiptNote  @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([organizationId, grnId])
  @@map("grn_items")
}

// ---------------------------------------------------------------------------
// Supplier Bill / Accounts Payable — the Procurement Core's terminus into AP.
// A bill only becomes financial (Payable + GL posting) once APPROVED; DRAFT /
// APPROVAL_PENDING bills are pure matching/review state with zero accounting side effects.
// ---------------------------------------------------------------------------

model SupplierBill {
  id                   String             @id @default(cuid())
  organizationId       String
  billNo               String
  supplierInvoiceNo    String
  supplierInvoiceDate  DateTime
  supplierId           String
  purchaseOrderId      String
  cmsWorkId            String?
  paymentTermId        String?
  currency             String             @default("BDT")
  dueDate              DateTime?
  remarks              String?
  status               SupplierBillStatus @default(DRAFT)
  matchStatus          BillMatchStatus    @default(MATCHED)
  subtotal             Decimal            @default(0) @db.Decimal(18, 2)
  discountAmount       Decimal            @default(0) @db.Decimal(18, 2)
  taxableBase          Decimal            @default(0) @db.Decimal(18, 2)
  vatRate              Decimal?           @db.Decimal(8, 4)
  vatAmount            Decimal            @default(0) @db.Decimal(18, 2)
  aitRate              Decimal?           @db.Decimal(8, 4)
  aitAmount            Decimal            @default(0) @db.Decimal(18, 2)
  otherDeductionAmount Decimal            @default(0) @db.Decimal(18, 2)
  netPayable           Decimal            @default(0) @db.Decimal(18, 2)
  /// Set only once APPROVED — this is the single Payable this bill produced.
  payableId            String?            @unique
  submittedAt          DateTime?
  approvedById         String?
  approvedAt           DateTime?
  rejectedReason       String?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier      Party                   @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id])
  cmsWork       CmsWork?                @relation(fields: [cmsWorkId], references: [id])
  paymentTerm   PaymentTerm?            @relation(fields: [paymentTermId], references: [id])
  payable       Payable?                @relation(fields: [payableId], references: [id])
  items         SupplierBillItem[]
  deductions    SupplierBillDeduction[]
  documents     Document[]

  @@unique([organizationId, billNo])
  @@unique([organizationId, supplierId, supplierInvoiceNo])
  @@index([organizationId, status])
  @@index([organizationId, purchaseOrderId])
  @@map("supplier_bills")
}

/// Snapshotted item detail per bill line — mirrors ProjectBillItem's pattern. `acceptedQty`/
/// `previouslyBilledQty` are recomputed fresh (not trusted from a stale cache) at both match-time
/// and approval-time, matching ProjectBill's own defense against drift/races.
model SupplierBillItem {
  id                   String          @id @default(cuid())
  organizationId       String
  supplierBillId       String
  purchaseOrderItemId  String
  itemId               String
  itemCodeSnapshot     String
  itemNameSnapshot     String
  descriptionSnapshot  String?
  unitSnapshot         String
  orderedQty           Decimal         @db.Decimal(18, 3)
  acceptedQty          Decimal         @db.Decimal(18, 3)
  previouslyBilledQty  Decimal         @db.Decimal(18, 3)
  currentBilledQty     Decimal         @db.Decimal(18, 3)
  remainingBillableQty Decimal         @db.Decimal(18, 3)
  poRate               Decimal         @db.Decimal(18, 2)
  invoiceRate          Decimal         @db.Decimal(18, 2)
  discountAmount       Decimal         @default(0) @db.Decimal(18, 2)
  lineAmount           Decimal         @db.Decimal(18, 2)
  matchStatus          BillMatchStatus
  remarks              String?

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierBill      SupplierBill      @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  item              Item              @relation(fields: [itemId], references: [id])

  @@index([organizationId, supplierBillId])
  @@index([organizationId, purchaseOrderItemId])
  @@map("supplier_bill_items")
}

/// Generic snapshotted deduction line (VAT / AIT / OTHER) — mirrors BillAdjustment's rate/base/
/// amount snapshot so a later DeductionConfig change never rewrites an already-approved bill.
model SupplierBillDeduction {
  id             String  @id @default(cuid())
  organizationId String
  supplierBillId String
  type           String
  code           String?
  rate           Decimal @db.Decimal(8, 4)
  base           Decimal @db.Decimal(18, 2)
  amount         Decimal @db.Decimal(18, 2)
  remarks        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierBill SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)

  @@index([organizationId, supplierBillId])
  @@map("supplier_bill_deductions")
}

/// One row per discrete payment against a Payable. Payable.paidAmount stays the single running-
/// total source of truth (kept in sync transactionally with an optimistic-lock guard), but this
/// table gives each payment its own reversible GL/Cash-Bank posting and audit trail — something
/// the generic AccountingService.payPayable() cash path does not provide on its own.
model SupplierPayment {
  id                 String                @id @default(cuid())
  organizationId     String
  payableId          String
  supplierId         String
  bankAccountId      String
  amount             Decimal               @db.Decimal(18, 2)
  paymentDate        DateTime
  paymentMethod      String?
  referenceNo        String?
  remarks            String?
  status             SupplierPaymentStatus @default(ACTIVE)
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  createdById        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payable      Payable      @relation(fields: [payableId], references: [id])
  supplier     Party        @relation(fields: [supplierId], references: [id])
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])
  documents    Document[]

  @@index([organizationId, payableId])
  @@index([organizationId, supplierId])
  @@map("supplier_payments")
}

// ---------------------------------------------------------------------------
// Vendor License Portal
//
// Product-level licensing/activation tracking for selling the ERP itself
// (one-time or SaaS), owned by the vendor's own master-admin panel. This is
// intentionally independent of the tenant-facing License/Subscription/Plan
// models above (those track "what an Organization sees about its own plan
// inside the app"; these track "what the vendor sees about every sale across
// every customer, including one-time customers whose app instance runs on a
// disconnected database"). A VendorCustomer may optionally reference an
// Organization by id (for SaaS customers hosted on this database) but there
// is deliberately no FK, since one-time/self-hosted customers won't have one.
// ---------------------------------------------------------------------------

enum VendorLicenseType {
  ONE_TIME
  SUBSCRIPTION
  TRIAL
}

enum VendorLicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
}

enum VendorDeviceStatus {
  ACTIVE
  DEACTIVATED
}

enum VendorBillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum VendorSubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

model VendorAdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("vendor_admin_users")
}

model VendorLicensePackage {
  id           String              @id @default(cuid())
  code         String              @unique
  name         String
  description  String?
  type         VendorLicenseType   @default(SUBSCRIPTION)
  /// Only meaningful when type = SUBSCRIPTION; null for ONE_TIME/TRIAL packages.
  billingCycle VendorBillingCycle?
  maxDevices   Int                 @default(3)
  /// Trial length in days for TRIAL packages; length of one billing period for SUBSCRIPTION packages; null (perpetual) for ONE_TIME.
  durationDays Int?
  price        Decimal?            @db.Decimal(12, 2)
  currency     String              @default("USD")
  features     Json?
  isActive     Boolean             @default(true)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  licenseKeys   VendorLicenseKey[]
  subscriptions VendorSubscription[]

  @@map("vendor_license_packages")
}

model VendorCustomer {
  id             String   @id @default(cuid())
  companyName    String
  contactName    String?
  email          String   @unique
  phone          String?
  address        String?
  organizationId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  licenseKeys   VendorLicenseKey[]
  downloads     VendorDownloadEvent[]
  subscriptions VendorSubscription[]

  @@map("vendor_customers")
}

model VendorLicenseKey {
  id                   String              @id @default(cuid())
  licenseKey           String              @unique
  customerId           String
  packageId            String
  type                 VendorLicenseType
  status               VendorLicenseStatus @default(ACTIVE)
  maxDevices           Int
  issuedAt             DateTime            @default(now())
  startsAt             DateTime            @default(now())
  expiresAt            DateTime?
  lastValidatedAt      DateTime?
  revokedAt            DateTime?
  revokedReason        String?
  notes                String?
  /// Set on a TRIAL row once it has been upgraded to a paid license; points at the new license.
  convertedToLicenseId String?             @unique
  convertedAt          DateTime?
  /// Device fingerprint captured at trial-request time (before any VendorDeviceActivation exists) so a
  /// repeat trial request from the same install can be recognized and reused instead of issuing a new one.
  trialDeviceId        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  customer           VendorCustomer           @relation(fields: [customerId], references: [id])
  package            VendorLicensePackage     @relation(fields: [packageId], references: [id])
  activations        VendorDeviceActivation[]
  events             VendorLicenseEvent[]
  subscription       VendorSubscription?
  convertedToLicense VendorLicenseKey?        @relation("TrialConversion", fields: [convertedToLicenseId], references: [id])
  convertedFromTrial VendorLicenseKey?        @relation("TrialConversion")

  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
  @@index([trialDeviceId])
  @@map("vendor_license_keys")
}

model VendorDeviceActivation {
  id             String             @id @default(cuid())
  licenseKeyId   String
  deviceId       String
  deviceName     String?
  hostname       String?
  platform       String?
  appVersion     String?
  ipAddress      String?
  status         VendorDeviceStatus @default(ACTIVE)
  activatedAt    DateTime           @default(now())
  lastSeenAt     DateTime           @default(now())
  /// Updated by POST /vendor-license/verify — distinct from lastSeenAt (heartbeat), which drives the online/offline dashboard calc.
  lastVerifiedAt DateTime?
  deactivatedAt  DateTime?

  licenseKey VendorLicenseKey @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)

  @@unique([licenseKeyId, deviceId])
  @@index([lastSeenAt])
  @@map("vendor_device_activations")
}

model VendorLicenseEvent {
  id           String   @id @default(cuid())
  licenseKeyId String
  type         String
  message      String?
  metadata     Json?
  /// The vendor admin who performed this action; null for system/client-triggered events (device self-activation, auto-expiry cron).
  actorAdminId String?
  createdAt    DateTime @default(now())

  licenseKey VendorLicenseKey @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)

  @@index([licenseKeyId])
  @@index([createdAt])
  @@map("vendor_license_events")
}

model VendorDownloadEvent {
  id          String   @id @default(cuid())
  customerId  String?
  email       String?
  companyName String?
  version     String?
  platform    String?
  ipAddress   String?
  source      String?
  createdAt   DateTime @default(now())

  customer VendorCustomer? @relation(fields: [customerId], references: [id])

  @@index([createdAt])
  @@map("vendor_download_events")
}

/// SaaS billing relationship for a SUBSCRIPTION-type VendorLicenseKey. Kept separate from
/// VendorLicenseKey.status (which stays the single source of truth for "can this credential
/// authorize devices right now", checked by activate/verify/heartbeat) because a subscription
/// can be CANCELLED (rides out to period end, license stays ACTIVE) while a license is only
/// ever ACTIVE/EXPIRED/SUSPENDED/REVOKED — suspend/cancel/renew here cascade onto the parent
/// license so the client-facing hot path never needs to join into this table.
model VendorSubscription {
  id               String                   @id @default(cuid())
  licenseKeyId     String                   @unique
  customerId       String
  packageId        String
  billingCycle     VendorBillingCycle
  status           VendorSubscriptionStatus @default(ACTIVE)
  startedAt        DateTime                 @default(now())
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  licenseKey VendorLicenseKey     @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)
  customer   VendorCustomer       @relation(fields: [customerId], references: [id])
  package    VendorLicensePackage @relation(fields: [packageId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("vendor_subscriptions")
}

// ---------------------------------------------------------------------------
// Fixed Assets
// ---------------------------------------------------------------------------

model AssetCategory {
  id                              String                       @id @default(cuid())
  organizationId                  String
  parentId                        String?
  name                            String
  code                            String
  defaultUsefulLifeMonths         Int?
  defaultSalvageValue             Decimal?                     @db.Decimal(18, 4)
  defaultDepreciationMethod       FixedAssetDepreciationMethod @default(STRAIGHT_LINE)
  assetLedgerId                   String?
  accumulatedDepreciationLedgerId String?
  depreciationExpenseLedgerId     String?
  isActive                        Boolean                      @default(true)
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt

  organization                  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent                        AssetCategory?  @relation("AssetCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                      AssetCategory[] @relation("AssetCategoryHierarchy")
  assetLedger                   LedgerAccount?  @relation("AssetCategoryAssetLedger", fields: [assetLedgerId], references: [id], onDelete: Restrict)
  accumulatedDepreciationLedger LedgerAccount?  @relation("AssetCategoryAccumulatedDepreciationLedger", fields: [accumulatedDepreciationLedgerId], references: [id], onDelete: Restrict)
  depreciationExpenseLedger     LedgerAccount?  @relation("AssetCategoryDepreciationExpenseLedger", fields: [depreciationExpenseLedgerId], references: [id], onDelete: Restrict)
  assets                        FixedAsset[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([parentId])
  @@map("asset_categories")
}

model FixedAsset {
  id                       String                       @id @default(cuid())
  organizationId           String
  assetLedgerId            String                       @unique
  assetCode                String
  categoryId               String?
  supplierId               String?
  fundingMode              AssetFundingMode             @default(CASH_BANK)
  fundingBankAccountId     String?
  payableId                String?
  acquisitionJournalId     String?
  name                     String
  category                 String?
  location                 String?
  department               String?
  assignedToName           String?
  brand                    String?
  model                    String?
  manufacturer             String?
  serialNumber             String?
  registrationNumber       String?
  condition                AssetCondition               @default(GOOD)
  operationalStatus        AssetOperationalStatus       @default(AVAILABLE)
  acquisitionType          AssetAcquisitionType         @default(DIRECT_PURCHASE)
  notes                    String?
  purchaseDate             DateTime                     @db.Date
  purchaseCost             Decimal                      @db.Decimal(18, 4)
  transportationCost       Decimal                      @default(0) @db.Decimal(18, 4)
  installationCost         Decimal                      @default(0) @db.Decimal(18, 4)
  importDuty               Decimal                      @default(0) @db.Decimal(18, 4)
  registrationCost         Decimal                      @default(0) @db.Decimal(18, 4)
  otherCapitalizedCost     Decimal                      @default(0) @db.Decimal(18, 4)
  discountAmount           Decimal                      @default(0) @db.Decimal(18, 4)
  capitalizedCost          Decimal                      @db.Decimal(18, 4)
  salvageValue             Decimal                      @default(0) @db.Decimal(18, 4)
  usefulLifeMonths         Int
  depreciationMethod       FixedAssetDepreciationMethod @default(STRAIGHT_LINE)
  useManualDepreciation    Boolean                      @default(false)
  manualDepreciationAmount Decimal?                     @db.Decimal(18, 4)
  status                   FixedAssetStatus             @default(ACTIVE)
  disposalDate             DateTime?                    @db.Date
  disposalProceeds         Decimal?                     @db.Decimal(18, 4)
  createdById              String
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  organization        Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetLedger         LedgerAccount                 @relation("FixedAssetLedger", fields: [assetLedgerId], references: [id], onDelete: Restrict)
  assetCategory       AssetCategory?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier            Party?                        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  depreciationEntries FixedAssetDepreciationEntry[]

  @@unique([organizationId, assetCode])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, supplierId])
  @@map("fixed_assets")
}

