  organizationId String
  workId         String
  contractId     String
  releaseNo      String
  amount         Decimal                @db.Decimal(18, 2)
  releaseDueDate DateTime?
  releaseDate    DateTime?
  reference      String?
  remarks        String?
  status         RetentionReleaseStatus @default(DRAFT)
  createdById    String?
  approvedById   String?
