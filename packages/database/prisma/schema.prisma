model Tender {
  id                      String                      @id @default(cuid())
  organizationId          String
  organizationMasterId    String?
  /// Business Tender ID. Kept nullable only so legacy rows can remain readable;
  /// every new tender must supply it through the validated service contract.
  egpTenderId             String?
  /// Upper-cased, trimmed, whitespace-collapsed server-authoritative key used
  /// for tenant-scoped duplicate protection. Legacy rows without a Tender ID stay null.
  tenderIdNormalized      String?
  /// Migration-only exemption for pre-existing rows that did not have a business Tender ID.
  /// Application create/update contracts never accept this flag.
  legacyTenderIdExempt    Boolean                     @default(false)
  workName                String
  category                String?
  tenderType              String?
  /// Standardized procurement method used by all new workflows.
  procurementMethod       TenderProcurementMethod     @default(OTM)
  /// Original pre-workflow text retained so a non-standard historical value is
  /// never discarded while the standardized method safely falls back to OTM.
  legacyProcurementMethod String?
  tenderMethod            String?
  contractValue           Decimal                     @default(0) @db.Decimal(18, 2)
  status                  TenderStatus                @default(DRAFT)
  costingApprovalStatus   TenderCostingApprovalStatus @default(DRAFT)
  progressPercentage      Int                         @default(0)
  payOrderRequired        Boolean                     @default(false)
  payOrderAmount          Decimal?                    @db.Decimal(18, 2)
  foundByUserId           String?
  foundByName             String?
  findingDate             DateTime?
  remarks                 String?
  version                 Int                         @default(1)

  publishedDate                 DateTime?
  documentPurchaseDeadline      DateTime?
  preBidDate                    DateTime?
  submissionDeadline            DateTime?
  openingDate                   DateTime?
  tenderSecurityRequired        Boolean   @default(false)
  estimatedTenderSecurityAmount Decimal?  @db.Decimal(18, 2)
  assignedToUserId              String?
  assignedToName                String?
  description                   String?

  // Submission (section 5.1)
  submissionDate      DateTime?
  submissionMethod    String?
  quotedAmount        Decimal?  @db.Decimal(18, 2)
  submittedById       String?
  submittedByName     String?
  submissionReference String?
  checklistStatus     String?
  submissionRemarks   String?
  submittedAt         DateTime?

  // Opening / Result (section 5.2) — status transitions reuse the TenderStatus enum
  // (UNDER_PROCESS is surfaced to users as "Under Evaluation", REJECTED as "Unsuccessful")
  // rather than introducing a second, duplicate result-status field.
  openingResult   String?
  lowestBidAmount Decimal?  @db.Decimal(18, 2)
  lowestBidder    String?
  resultRemarks   String?
  awardedAt       DateTime?

  costingSubmittedAt     DateTime?
  costingSubmittedById   String?
  costingApprovedAt      DateTime?
  costingApprovedById    String?
  costingRejectedAt      DateTime?
  costingRejectedById    String?
  costingRejectionReason String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationMaster OrganizationMaster? @relation(fields: [organizationMasterId], references: [id])
  createdBy          User?               @relation("TenderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  foundBy            User?               @relation("TenderFoundBy", fields: [foundByUserId], references: [id], onDelete: SetNull)
  costingSubmittedBy User?               @relation("TenderCostingSubmittedBy", fields: [costingSubmittedById], references: [id], onDelete: SetNull)
  costingApprovedBy  User?               @relation("TenderCostingApprovedBy", fields: [costingApprovedById], references: [id], onDelete: SetNull)
  costingRejectedBy  User?               @relation("TenderCostingRejectedBy", fields: [costingRejectedById], references: [id], onDelete: SetNull)
  costing            TenderCosting?

  documentPurchases     DocumentPurchase[]
  tenderSecurities      TenderSecurity[]
  creditCommitments     CreditCommitment[]
  performanceGuarantees PerformanceGuarantee[]
  receipts              Receipt[]
  cmsWorks              CmsWork[]
  documents             Document[]
  contracts             ProjectContract[]
  workIous              WorkIou[]

  @@unique([organizationId, id])
  @@unique([organizationId, tenderIdNormalized])
  @@index([organizationId, status])
  @@index([organizationId, costingApprovalStatus, updatedAt])
  @@index([organizationId, submissionDeadline])
  @@map("tenders")
}

model TenderCosting {
  id                     String              @id @default(cuid())
