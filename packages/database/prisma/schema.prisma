// ---------------------------------------------------------------------------
// Tenancy / Identity
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  shortName String?
  /// ACTIVE | SUSPENDED | ARCHIVED — safe lifecycle in place of destructive delete.
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                          OrganizationUser[]
  roles                          Role[]
  subscription                   Subscription?
  licenses                       License[]
  organizationMasters            OrganizationMaster[]
  bankAccounts                   BankAccount[]
  tenders                        Tender[]
  tenderCostings                 TenderCosting[]
  tenderCostingItems             TenderCostingItem[]
  documentPurchases              DocumentPurchase[]
  tenderSecurities               TenderSecurity[]
  creditCommitments              CreditCommitment[]
  pgBgWorkflows                  PgBgWorkflow[]
  organizationContacts           OrganizationContact[]
  cmsWorks                       CmsWork[]
  performanceGuarantees          PerformanceGuarantee[]
  expenses                       Expense[]
  expenseAttachments             ExpenseAttachment[]
  expenseHeads                   ExpenseHead[]
  workIous                       WorkIou[]
  workIouItems                   WorkIouItem[]
  workIouAttachments             WorkIouAttachment[]
  receipts                       Receipt[]
  receiptSequences               ReceiptSequence[]
  reminders                      Reminder[]
  notifications                  Notification[]
  documents                      Document[]
  auditLogs                      AuditLog[]
  appSettings                    AppSetting[]
  monthlyTargets                 MonthlyTarget[]
  ledgerAccounts                 LedgerAccount[]
  journalEntries                 JournalEntry[]
  payables                       Payable[]
  financialTransactions          FinancialTransaction[]
  fundTransfers                  FundTransfer[]
  bankReconciliations            BankReconciliation[]
  cheques                        Cheque[]
  generalSetting                 GeneralSetting?
  companyProfile                 CompanyProfile?
  tenderBankSetting              TenderBankSetting?
  financeSetting                 FinanceSetting?
  accountingPeriods              AccountingPeriod[]
  numberSequences                NumberSequence[]
  reminderRuleSettings           ReminderRuleSetting[]
  documentSetting                DocumentSetting?
  approvalRules                  ApprovalRule[]
  securitySetting                SecuritySetting?
  systemSetting                  SystemSetting?
  billingProfile                 BillingProfile?
  invoices                       Invoice[]
  projectContracts               ProjectContract[]
  projectBudgets                 ProjectBudget[]
  boqSections                    BoqSection[]
  boqItems                       BoqItem[]
  projectBills                   ProjectBill[]
  challanSubmissions             ChallanSubmission[]
  challanSubmissionItems         ChallanSubmissionItem[]
  challanSubmissionStatusHistory ChallanSubmissionStatusHistory[]
  vatTaxCertificates             VatTaxCertificate[]
  receivables                    Receivable[]
  variationOrders                VariationOrder[]
  timeExtensions                 TimeExtension[]
  deductionConfigs               DeductionConfig[]
  completionCertificates         CompletionCertificate[]
  defectLiabilityPeriods         DefectLiabilityPeriod[]
  defects                        DlpDefect[]
  retentionReleases              RetentionRelease[]
  projectHandovers               ProjectHandover[]
  projectClosureEvents           ProjectClosureEvent[]
  parties                        Party[]
  masterCategories               MasterCategory[]
  unitsOfMeasurement             UnitOfMeasurement[]
  paymentTerms                   PaymentTerm[]
  items                          Item[]
  subcontractorProfiles          SubcontractorProfile[]
  purchaseRequisitions           PurchaseRequisition[]
  purchaseRequisitionItems       PurchaseRequisitionItem[]
  requestForQuotations           RequestForQuotation[]
  rfqSuppliers                   RfqSupplier[]
  rfqItems                       RfqItem[]
  supplierQuotations             SupplierQuotation[]
  supplierQuotationItems         SupplierQuotationItem[]
  comparativeStatements          ComparativeStatement[]
  comparativeStatementSuppliers  ComparativeStatementSupplier[]
  purchaseOrders                 PurchaseOrder[]
  purchaseOrderItems             PurchaseOrderItem[]
  goodsReceiptNotes              GoodsReceiptNote[]
  grnItems                       GrnItem[]
  supplierBills                  SupplierBill[]
  supplierBillItems              SupplierBillItem[]
  supplierBillDeductions         SupplierBillDeduction[]
  supplierPayments               SupplierPayment[]
  salesQuotations                SalesQuotation[]
  salesQuotationItems            SalesQuotationItem[]
  salesQuotationOverheads        SalesQuotationOverhead[]
  salesQuotationFollowUps        SalesQuotationFollowUp[]
  salesQuotationStatusHistory    SalesQuotationStatusHistory[]
  assetCategories                AssetCategory[]
  fixedAssets                    FixedAsset[]
  fixedAssetDepreciationEntries  FixedAssetDepreciationEntry[]
  departments                    Department[]
  designations                   Designation[]
  grades                         Grade[]
  businessUnits                  BusinessUnit[]
  hrDivisions                    HrDivision[]
  hrLocations                    HrLocation[]
  costCenters                    CostCenter[]
  employees                      Employee[]
  attendanceRecords              AttendanceRecord[]
  payrollRuns                    PayrollRun[]
  payslips                       Payslip[]
  leaveTypes                     LeaveType[]
  leaveRequests                  LeaveRequest[]
  shifts                         Shift[]
  payrollSetting                 PayrollSetting?
  holidays                       Holiday[]
  employeeChangeRecords          EmployeeChangeRecord[]
  exitProcesses                  ExitProcess[]
  hrExpenseClaims                HrExpenseClaim[]
  employeeLoans                  EmployeeLoan[]
  loanRepayments                 LoanRepayment[]
  jobOpenings                    JobOpening[]
  candidates                     Candidate[]
  jobApplications                JobApplication[]
  onboardingChecklists           OnboardingChecklist[]
  warehouses                     Warehouse[]
  stockMovements                 StockMovement[]
  lcMasters                      LcMaster[]
  lcStatusHistory                LcStatusHistory[]
  lcItems                        LcItem[]
  lcInventoryPostings            LcInventoryPosting[]
  lcShipments                    LcShipment[]
  lcCostHeads                    LcCostHead[]
  lcCostEntries                  LcCostEntry[]
  lcCostAllocations              LcCostAllocation[]
  lcGrns                         LcGrn[]
  lcGrnItems                     LcGrnItem[]
  lcLandedCosts                  LcLandedCost[]
  lcLandedCostItems              LcLandedCostItem[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations                OrganizationUser[]
  refreshTokens                RefreshToken[]
  auditLogs                    AuditLog[]
  expensesThrough              Expense[]                     @relation("ExpenseThrough")
  notifications                Notification[]
  salesQuotationsCreated       SalesQuotation[]              @relation("SalesQuotationCreatedBy")
  salesQuotationsAssigned      SalesQuotation[]              @relation("SalesQuotationSalesPerson")
  salesQuotationsSent          SalesQuotation[]              @relation("SalesQuotationSentBy")
  salesQuotationsDecided       SalesQuotation[]              @relation("SalesQuotationDecisionBy")
  salesQuotationFollowUps      SalesQuotationFollowUp[]
  salesQuotationStatusChanges  SalesQuotationStatusHistory[]
  workIousPaidBy               WorkIou[]                     @relation("WorkIouPaidBy")
  workIousSubmittedBy          WorkIou[]                     @relation("WorkIouSubmittedBy")
  workIousCancelledBy          WorkIou[]                     @relation("WorkIouCancelledBy")
  workIousCreatedBy            WorkIou[]                     @relation("WorkIouCreatedBy")
  workIouAttachmentsUploadedBy WorkIouAttachment[]           @relation("WorkIouAttachmentUploadedBy")
  tendersCreated               Tender[]                      @relation("TenderCreatedBy")
  tendersFound                 Tender[]                      @relation("TenderFoundBy")
  tendersCostingSubmitted      Tender[]                      @relation("TenderCostingSubmittedBy")
  tendersCostingApproved       Tender[]                      @relation("TenderCostingApprovedBy")
  tendersCostingRejected       Tender[]                      @relation("TenderCostingRejectedBy")
  tenderCostingsPrepared       TenderCosting[]               @relation("TenderCostingPreparedBy")
  tenderCostingsAssigned       TenderCosting[]               @relation("TenderCostingAssignedTo")
  tenderCostingsApproved       TenderCosting[]               @relation("TenderCostingApprovedForBy")

  @@map("users")
}

model OrganizationUser {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  isDefault      Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_users")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions       RolePermission[]
  organizationUsers OrganizationUser[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  group       String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Licensing / Subscription
// ---------------------------------------------------------------------------

model License {
  id             String    @id @default(cuid())
  organizationId String
  licenseKey     String    @unique
  seats          Int       @default(1)
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("licenses")
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  /// Legacy coarse plan tag, superseded by `planId` — kept unmodified to avoid an enum rename.
  plan               SubscriptionPlan   @default(TRIAL)
  planId             String?
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       String             @default("MONTHLY")
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  startedAt          DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelRequestedAt  DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planRef      Plan?        @relation(fields: [planId], references: [id])
  invoices     Invoice[]

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Masters
// ---------------------------------------------------------------------------

model OrganizationMaster {
  id             String   @id @default(cuid())
  organizationId String
  shortName      String
  fullName       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenders               Tender[]
  documentPurchases     DocumentPurchase[]
  tenderSecurities      TenderSecurity[]
  creditCommitments     CreditCommitment[]
  pgBgWorkflows         PgBgWorkflow[]
  contacts              OrganizationContact[]
  cmsWorks              CmsWork[]
  performanceGuarantees PerformanceGuarantee[]
  documents             Document[]
  projectContracts      ProjectContract[]
  salesQuotations       SalesQuotation[]

  @@unique([organizationId, shortName])
  @@map("organization_masters")
}

enum SalesQuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model SalesQuotation {
  id                String               @id @default(cuid())
  organizationId    String
  quotationNo       String
  customerId        String
  workName          String
  quotationDate     DateTime
  validUntil        DateTime
  currency          String               @default("BDT")
  status            SalesQuotationStatus @default(DRAFT)
  salesPersonId     String?
  remarks           String?
  version           Int                  @default(1)
  totalCost         Decimal              @default(0) @db.Decimal(18, 2)
  itemTaxTotal      Decimal              @default(0) @db.Decimal(18, 2)
  totalSelling      Decimal              @default(0) @db.Decimal(18, 2)
  overheadTotal     Decimal              @default(0) @db.Decimal(18, 2)
  subtotalBeforeVat Decimal              @default(0) @db.Decimal(18, 2)
  vatApplicable     Boolean              @default(false)
  vatRate           Decimal              @default(0) @db.Decimal(5, 2)
  vatAmount         Decimal              @default(0) @db.Decimal(18, 2)
  grandTotal        Decimal              @default(0) @db.Decimal(18, 2)
  sentAt            DateTime?
  sentById          String?
  decisionDate      DateTime?
  decisionById      String?
  acceptedAmount    Decimal?             @db.Decimal(18, 2)
  customerPoWoNo    String?
  rejectionReason   String?
  lastFollowUpAt    DateTime?
  nextFollowUpAt    DateTime?
  createdById       String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organization  Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      OrganizationMaster            @relation(fields: [customerId], references: [id])
  salesPerson   User?                         @relation("SalesQuotationSalesPerson", fields: [salesPersonId], references: [id])
  sentBy        User?                         @relation("SalesQuotationSentBy", fields: [sentById], references: [id])
  decisionBy    User?                         @relation("SalesQuotationDecisionBy", fields: [decisionById], references: [id])
  createdBy     User                          @relation("SalesQuotationCreatedBy", fields: [createdById], references: [id])
  items         SalesQuotationItem[]
  overheads     SalesQuotationOverhead[]
  followUps     SalesQuotationFollowUp[]
  statusHistory SalesQuotationStatusHistory[]

  @@unique([organizationId, quotationNo])
  @@index([organizationId, status, quotationDate])
  @@index([organizationId, customerId])
  @@index([organizationId, salesPersonId])
  @@index([organizationId, workName])
  @@map("sales_quotations")
}

model SalesQuotationItem {
  id             String   @id @default(cuid())
  organizationId String
  quotationId    String
  description    String
  quantity       Decimal  @db.Decimal(18, 3)
  unit           String
  unitCost       Decimal  @db.Decimal(18, 2)
  totalCost      Decimal  @db.Decimal(18, 2)
  taxPct         Decimal  @db.Decimal(5, 2)
  taxAmount      Decimal  @db.Decimal(18, 2)
  unitPrice      Decimal  @db.Decimal(18, 2)
  totalPrice     Decimal  @db.Decimal(18, 2)
  profit         Decimal  @db.Decimal(18, 2)
  marginPct      Decimal  @db.Decimal(7, 4)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([organizationId, quotationId, sortOrder])
  @@map("sales_quotation_items")
}

model SalesQuotationOverhead {
  id             String   @id @default(cuid())
  organizationId String
  quotationId    String
  description    String
  amount         Decimal  @db.Decimal(18, 2)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([organizationId, quotationId, sortOrder])
  @@map("sales_quotation_overheads")
}

model SalesQuotationFollowUp {
  id             String    @id @default(cuid())
  organizationId String
  quotationId    String
  followedUpAt   DateTime
  nextFollowUpAt DateTime?
  notes          String?
  createdById    String
  createdAt      DateTime  @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  createdBy    User           @relation(fields: [createdById], references: [id])

  @@index([organizationId, quotationId, followedUpAt])
  @@index([organizationId, nextFollowUpAt])
  @@map("sales_quotation_follow_ups")
}

model SalesQuotationStatusHistory {
  id             String                @id @default(cuid())
  organizationId String
  quotationId    String
  fromStatus     SalesQuotationStatus?
  toStatus       SalesQuotationStatus
  changedById    String
  reason         String?
  changedAt      DateTime              @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  changedBy    User           @relation(fields: [changedById], references: [id])

  @@index([organizationId, quotationId, changedAt])
  @@map("sales_quotation_status_history")
}

model BankAccount {
  id                 String      @id @default(cuid())
  organizationId     String
  accountName        String
  accountType        AccountType
  bankName           String?
  accountNumber      String?
  branch             String?
  routingNumber      String?
  bankAccountType    String?
  openingBalance     Decimal     @default(0) @db.Decimal(18, 2)
  openingBalanceDate DateTime?
  currency           String      @default("BDT")
  remarks            String?
  isActive           Boolean     @default(true)
  currentBalance     Decimal     @default(0) @db.Decimal(18, 2)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentPurchases        DocumentPurchase[]
  tenderSecurities         TenderSecurity[]       @relation("TenderSecurityBankAccount")
  tenderSecurityCharges    TenderSecurity[]       @relation("TenderSecurityChargeFrom")
