  dlp                     DefectLiabilityPeriod @relation(fields: [dlpId], references: [id])
  work                    CmsWork               @relation(fields: [workId], references: [id])
  documents               Document[]

  @@unique([organizationId, defectNo])
  @@index([organizationId, workId, status])
  @@map("dlp_defects")
}

model RetentionRelease {
