model Reminder {
  id                   String    @id @default(cuid())
  organizationId       String
  type                 String
  title                String
  description          String?
  subtitle             String?
  priority             String    @default("MEDIUM")
  status               String    @default("UPCOMING")
  dueDate              DateTime
  dueTime              String?
  assignedToUserId     String?
  assignedToName       String?
  sourceModule         String    @default("MANUAL")
  sourceType           String?
  sourceId             String?
  relatedEntityType    String?
  relatedEntityId      String?
  relatedEntityName    String?
  referenceNo          String?
  organizationMasterId String?
  organizationName     String?
  notificationBefore   Int       @default(0)
  repeatType           String    @default("NONE")
  repeatConfig         Json?
  remarks              String?
  snoozedUntil         DateTime?
  createdById          String?
  createdByName        String?
  completedById        String?
  completedByName      String?
  completedAt          DateTime?
  cancelledAt          DateTime?
  isResolved           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([organizationId, sourceModule, sourceId, type, dueDate])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, assignedToUserId, dueDate])
  @@map("reminders")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  message        String
  reminderId     String?
  sourceModule   String?
  sourceType     String?
  sourceId       String?
  priority       String    @default("MEDIUM")
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder     Reminder?    @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId, reminderId, type])
  @@index([organizationId, userId, isRead, createdAt])
  @@map("notifications")
}

model Document {
  id                      String    @id @default(cuid())
  organizationId          String
  name                    String
  category                String?
  documentType            String?
  relatedModule           String?
  relatedEntityId         String?
  relatedEntityName       String?
  tenderId                String?
  workId                  String?
  contractId              String?
  projectBillId           String?
  challanSubmissionId     String?
  vatTaxCertificateId     String?
  variationOrderId        String?
  timeExtensionId         String?
  completionCertificateId String?
  dlpId                   String?
  defectId                String?
  retentionReleaseId      String?
  projectHandoverId       String?
  organizationMasterId    String?
  partyId                 String?
  purchaseRequisitionId   String?
  rfqId                   String?
  supplierQuotationId     String?
  comparativeStatementId  String?
  purchaseOrderId         String?
  goodsReceiptNoteId      String?
  supplierBillId          String?
  supplierPaymentId       String?
  referenceNumber         String?
  certificateNumber       String?
  issuingAuthority        String?
  account                 String?
  amount                  Decimal?  @db.Decimal(18, 2)
  issueDate               DateTime?
  expiryDate              DateTime?
  reminderDays            Int?
  responsiblePerson       String?
  description             String?
  tags                    String[]  @default([])
  /// ACTIVE | DRAFT | RENEWED | ARCHIVED
  status                  String    @default("ACTIVE")
  fileUrl                 String?
  fileName                String?
  fileType                String?
  fileSize                Int?
  /// Key/path in the DocumentStorageService adapter — never raw file bytes in Postgres.
  storageKey              String?
  currentVersion          Int       @default(1)
  uploadedById            String?
  uploadedByName          String?
  archivedAt              DateTime?
  archivedById            String?
  archivedByName          String?
  archiveReason           String?
  createdById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tender                Tender?                @relation(fields: [tenderId], references: [id])
  work                  CmsWork?               @relation(fields: [workId], references: [id])
  contract              ProjectContract?       @relation(fields: [contractId], references: [id])
  projectBill           ProjectBill?           @relation(fields: [projectBillId], references: [id])
  challanSubmission     ChallanSubmission?     @relation(fields: [challanSubmissionId], references: [id])
  vatTaxCertificate     VatTaxCertificate?     @relation(fields: [vatTaxCertificateId], references: [id])
  variationOrder        VariationOrder?        @relation(fields: [variationOrderId], references: [id])
  timeExtension         TimeExtension?         @relation(fields: [timeExtensionId], references: [id])
  completionCertificate CompletionCertificate? @relation(fields: [completionCertificateId], references: [id])
  dlp                   DefectLiabilityPeriod? @relation(fields: [dlpId], references: [id])
  defect                DlpDefect?             @relation(fields: [defectId], references: [id])
  retentionRelease      RetentionRelease?      @relation(fields: [retentionReleaseId], references: [id])
  projectHandover       ProjectHandover?       @relation(fields: [projectHandoverId], references: [id])
  organizationMaster    OrganizationMaster?    @relation(fields: [organizationMasterId], references: [id])
  party                 Party?                 @relation(fields: [partyId], references: [id])
  purchaseRequisition   PurchaseRequisition?   @relation(fields: [purchaseRequisitionId], references: [id])
  rfq                   RequestForQuotation?   @relation(fields: [rfqId], references: [id])
  supplierQuotation     SupplierQuotation?     @relation(fields: [supplierQuotationId], references: [id])
  comparativeStatement  ComparativeStatement?  @relation(fields: [comparativeStatementId], references: [id])
  purchaseOrder         PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptNote      GoodsReceiptNote?      @relation(fields: [goodsReceiptNoteId], references: [id])
  supplierBill          SupplierBill?          @relation(fields: [supplierBillId], references: [id])
  supplierPayment       SupplierPayment?       @relation(fields: [supplierPaymentId], references: [id])
  versions              DocumentVersion[]

  @@index([organizationId, category])
  @@index([organizationId, status])
  @@index([organizationId, expiryDate])
  // A partial unique index for active challanSubmissionId + documentType is enforced in SQL.
  @@index([challanSubmissionId])
  // A partial unique index for active vatTaxCertificateId + documentType is enforced in SQL.
  @@index([vatTaxCertificateId])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(cuid())
  documentId     String
  version        Int
  fileName       String
  fileType       String
  fileSize       Int
  storageKey     String
  uploadedById   String?
  uploadedByName String?
  changeNote     String?
  createdAt      DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

