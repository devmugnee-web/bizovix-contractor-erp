{
  "name": "mugnee-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-lan.ps1",
    "dev:web": "next dev",
    "dev:web:webpack": "next dev --webpack",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:lan": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-lan.ps1",
    "dev:lan:web": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-lan-web.ps1",
    "dev:lan:api": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-lan-api.ps1",
    "office:build": "powershell -ExecutionPolicy Bypass -File ./scripts/build-office-lan.ps1",
    "office:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-office-lan.ps1",
    "build:web": "next build",
    "build:api": "npm --prefix apps/api run build",
    "build": "npm run build:web && npm run build:api",
    "desktop:install": "cmd /c npm.cmd --prefix desktop install",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dist": "npm --prefix apps/api run prisma:generate && npm run build:web && npm --prefix apps/api run build && node scripts/prepare-desktop.mjs && npm --prefix desktop run dist",
    "desktop:pack": "npm --prefix apps/api run prisma:generate && npm run build:web && npm --prefix apps/api run build && node scripts/prepare-desktop.mjs && npm --prefix desktop run pack",
    "start": "next start",
    "lint:web": "eslint .",
    "lint:api": "npm --prefix apps/api run lint",
    "lint": "npm run lint:web && npm run lint:api",
    "typecheck:web": "tsc --noEmit",
    "typecheck:api": "npm --prefix apps/api run typecheck",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "test:web": "vitest run",
    "test:api": "npm --prefix apps/api run test",
    "test": "npm run test:web && npm run test:api",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "npm --prefix apps/api run prisma:generate",
    "prisma:migrate:dev": "npm --prefix apps/api run prisma:migrate:dev",
    "prisma:seed": "npm --prefix apps/api run prisma:seed"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
