model VoucherEntry {
  id                             String                          @id @default(uuid())
  tenantId                       String
  companyId                      String
  workspaceId                    String
  createdByUserId                String
  voucherType                    VoucherEntryType
  /// Which document in the purchase/sales flow this is (purchase-order,
  /// receipt-note, bill...). Null on legacy rows, which are treated as bills.
  documentKind                   String?
  /// The document this one was created from, so an order can be traced through
  /// its receipt notes and on to the bill.
  sourceVoucherId                String?
  /// Immutable transaction-level origin. Company workflow changes affect only
  /// how new root transactions start; they never reinterpret an existing row.
  workflowOrigin                 VoucherWorkflowOrigin           @default(DIRECT)
  voucherNumber                  String
  voucherDate                    DateTime
  partyName                      String
  partyId                        String?
  reference                      String?
  narration                      String?
  status                         VoucherEntryStatus              @default(DRAFT)
  settlementMode                 SettlementMode?
  /// Amount paid at document creation. Particularly useful for orders where
  /// payment method alone cannot describe a partial advance.
  paidAmount                     Decimal?                        @db.Decimal(18, 4)
  supplierAddress                String?
  condition                      String?
  buyerSignature                 String?
  sellerSignature                String?
  attachmentImageUrl             String?                         @db.Text
  attachmentDocumentUrl          String?                         @db.Text
  attachmentDocumentName         String?
  discountType                   DiscountType?
  discountAmount                 Decimal?                        @db.Decimal(18, 4)
  /// Difference posted to the Round Off ledger so the rounded document total
  /// still balances against the un-rounded line values. Null = not rounded.
  roundOffAmount                 Decimal?                        @db.Decimal(18, 4)
  loyaltyPointsEarned            Int                             @default(0)
  loyaltyPointsRedeemed          Int                             @default(0)
  loyaltyDiscountAmount          Decimal                         @default(0) @db.Decimal(18, 4)
  subtotal                       Decimal?                        @db.Decimal(18, 4)
  totalAmount                    Decimal                         @db.Decimal(18, 4)
  debit                          Decimal                         @db.Decimal(18, 4)
  credit                         Decimal                         @db.Decimal(18, 4)
  currency                       String                          @default("BDT")
  fiscalYearId                   String?
  branchId                       String?
  warehouseId                    String?
  sourceType                     String?
  sourceId                       String?
  postingVersion                 Int                             @default(1)
  approvedByUserId               String?
  approvedAt                     DateTime?
  postedAt                       DateTime?
  idempotencyKey                 String?
  reversalOfId                   String?
  revisionGroupId                String?
  previousRevisionId             String?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  tenant                         Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                        Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace                      Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser                  User                            @relation("VoucherCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  party                          Party?                          @relation(fields: [partyId], references: [id], onDelete: SetNull)
  fiscalYear                     FiscalYear?                     @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  branch                         Branch?                         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse                      Warehouse?                      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  reversalOf                     VoucherEntry?                   @relation("VoucherReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy                     VoucherEntry[]                  @relation("VoucherReversal")
  previousRevision               VoucherEntry?                   @relation("VoucherRevision", fields: [previousRevisionId], references: [id], onDelete: SetNull)
  nextRevisions                  VoucherEntry[]                  @relation("VoucherRevision")
  lines                          VoucherEntryLine[]
  inventoryItems                 VoucherInventoryItem[]
  inventoryCostRevaluations      InventoryCostRevaluation[]
  fixedAssetDepreciationEntry    FixedAssetDepreciationEntry?
  manufacturingTransactions      ManufacturingTransaction[]
  manufacturingCostSnapshots     ManufacturingCostSnapshot[]
  manufacturingActualCostPosting ManufacturingActualCostPosting?
  manufacturingPostingLinks      ManufacturingPostingLink[]

  @@unique([workspaceId, voucherNumber])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, voucherType, status, voucherDate])
  @@index([workspaceId, sourceVoucherId])
  @@index([sourceType, sourceId])
  @@index([fiscalYearId])
  @@index([branchId])
  @@index([warehouseId])
}

