generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // Pinned explicitly (not left to the "native" default) because the
  // generated client is committed to git and packaged for the Windows
  // desktop app: without this, whichever OS happens to run `prisma generate`
  // right before a commit determines which engine binary ships — a client
  // regenerated on a contributor's Mac/Linux machine would silently embed a
  // non-Windows engine, and the resulting installer would only fail to start
  // its API server once actually run on a customer's Windows PC, with no
  // reproduction on the packager's own machine unless they too regenerated on
  // the wrong OS. "native" is kept alongside so local development on any
  // platform still works without needing this array touched.
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

