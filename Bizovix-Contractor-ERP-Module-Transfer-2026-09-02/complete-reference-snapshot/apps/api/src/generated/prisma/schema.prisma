enum ManufacturingCostDriverBasis {
  FLAT
  OUTPUT_QUANTITY
  LABOUR_HOURS
  MACHINE_HOURS
  MATERIAL_COST_PERCENT
  PRIME_COST_PERCENT
}

enum ManufacturingStandardCostStatus {
  DRAFT
  APPROVED
  RETIRED
}

/// Workspace-owned rates for auditable labour, machine, factory-overhead,
/// subcontract and other manufacturing cost postings. Account IDs deliberately
/// reference existing ledgers: this workflow never creates or mutates Chart of
/// Accounts rows.
model ManufacturingCostDriver {
  id                 String                           @id @default(uuid())
  tenantId           String
  companyId          String
  workspaceId        String
  code               String
  name               String
  costType           ManufacturingCostType
  basis              ManufacturingCostDriverBasis
  unit               String?
  rate               Decimal                          @db.Decimal(24, 8)
  clearingAccountId  String
  effectiveFrom      DateTime?                        @db.Date
  effectiveTo        DateTime?                        @db.Date
  isActive           Boolean                          @default(true)
  createdByUserId    String
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  tenant             Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company            Company                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace          Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clearingAccount    Account                          @relation(fields: [clearingAccountId], references: [id], onDelete: Restrict)
  createdBy          User                             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  standardCostLines  ManufacturingStandardCostLine[]
  actualCostPostings ManufacturingActualCostPosting[]

  @@unique([workspaceId, code])
  @@index([workspaceId, costType, isActive])
  @@index([clearingAccountId])
}

/// Immutable, versioned per-unit standard cost used only after approval.
