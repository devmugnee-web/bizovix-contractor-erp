}

enum SettlementMode {
  CASH
  BANK
  ACCOUNTS_PAYABLE
}

enum DiscountType {
  FIXED
  PERCENT
}

enum VoucherEntryType {
  CONTRA
  PAYMENT
  RECEIPT
  JOURNAL
  SALES
  PURCHASE
  EXPENSE
  REVENUE
  CREDIT_NOTE
  DEBIT_NOTE
  QUOTATION
  PROFORMA_INVOICE
  SALES_ORDER
  DELIVERY_NOTE
  PURCHASE_ORDER
  RECEIPT_NOTE
}

/// Company policy for starting new purchase/sales transactions. BOTH is the
/// hybrid option: direct bills/invoices and order-based documents may coexist.
enum TransactionWorkflowPolicy {
  DIRECT
  ORDER_BASED
  BOTH
}

/// Captured when a voucher is first created. Unlike the company's current
/// policy, this never changes, so an in-flight/historical chain keeps its own
/// validation and stock semantics after any later mode switch.
enum VoucherWorkflowOrigin {
  DIRECT
  ORDER_FLOW
}

enum FiscalYearStatus {
  OPEN
  LOCKED
  CLOSED
}

enum AccountingFramework {
  BFRS_IFRS
  US_GAAP
}

enum CostingMethod {
  MOVING_WEIGHTED_AVERAGE
  PERIODIC_WEIGHTED_AVERAGE
  FIFO
  LIFO
}

enum NegativeStockPolicy {
  BLOCKED
  ALLOW_ZERO
  ALLOW_NEGATIVE
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

// A Category nests under a Main Category or another Category to unlimited
// depth (see accounts/account-code.util.ts for how depth interacts with the
// positional code scheme); a Ledger is always a leaf and never has children.
enum AccountLevel {
  MAIN_CATEGORY
  CATEGORY
  LEDGER
}

