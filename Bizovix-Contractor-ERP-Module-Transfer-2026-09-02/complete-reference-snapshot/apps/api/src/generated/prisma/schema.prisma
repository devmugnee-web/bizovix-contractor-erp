model ManufacturingStandardCostLine {
  id                String                           @id @default(uuid())
  versionId         String
  sequence          Int
  costType          ManufacturingCostType
  description       String
  quantity          Decimal                          @default(1) @db.Decimal(18, 6)
  rate              Decimal                          @default(0) @db.Decimal(24, 8)
  amount            Decimal                          @db.Decimal(24, 6)
  costDriverId      String?
  clearingAccountId String?
  metadata          Json?
