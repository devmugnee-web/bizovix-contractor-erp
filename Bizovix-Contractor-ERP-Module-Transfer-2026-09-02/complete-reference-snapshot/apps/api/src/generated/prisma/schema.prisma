enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  PERMANENT
  PROBATION
  CONTRACTUAL
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  TERMINATED
}

enum SalaryPaymentMethod {
  CASH
  BANK
  MFS
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
}

enum PayslipPaymentStatus {
  PENDING
  PAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// A workspace-managed, flat list of department names. No hierarchy — just an
// addable/deletable pick-list Employee.departmentId points into. Deleting one
// clears it from employees that used it (see Employee.departmentId) rather
// than blocking the delete, so the list stays easy to groom.
model Department {
  id          String       @id @default(uuid())
  tenantId    String
  companyId   String
  workspaceId String
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees   Employee[]
  jobOpenings JobOpening[]

  @@unique([workspaceId, name])
}

// Same shape as Department, kept as an independent flat list rather than
// nested under a department — this app's designations aren't department-specific.
model Designation {
  id          String       @id @default(uuid())
  tenantId    String
  companyId   String
  workspaceId String
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees   Employee[]
  jobOpenings JobOpening[]

  @@unique([workspaceId, name])
}

// An employee master record. Salary is one Gross figure plus a freeform list
// of named percentage components (salaryComponents: [{name, percent}]) that
// must add up to 100% of it — Basic/House Rent/Medical/Conveyance are just
// the default starting rows, not a fixed schema, so a business can rename,
// add (e.g. a Bonus row) or remove components per employee.
model Employee {
  id                  String                 @id @default(uuid())
  tenantId            String
  companyId           String
  workspaceId         String
  employeeCode        String
  name                String
  fatherOrSpouseName  String?
  gender              Gender?
  dateOfBirth         DateTime?              @db.Date
  phone               String?
  email               String?
  presentAddress      String?
  permanentAddress    String?
  nationalId          String?
  departmentId        String?
  designationId       String?
  gradeId             String?
  businessUnitId      String?
  divisionId          String?
  locationId          String?
  costCenterId        String?
  reportingManagerId  String?
  employmentType      EmploymentType         @default(PERMANENT)
  status              EmployeeStatus         @default(ACTIVE)
  joiningDate         DateTime               @db.Date
  probationEndDate    DateTime?              @db.Date
  contractEndDate     DateTime?              @db.Date
  resignationDate     DateTime?              @db.Date
  grossSalary         Decimal                @db.Decimal(18, 4)
  salaryComponents    Json
  pfRate              Decimal?               @db.Decimal(5, 2)
  paymentMethod       SalaryPaymentMethod    @default(CASH)
  bankName            String?
  bankAccountNumber   String?
  mfsProvider         String?
  mfsAccountNumber    String?
  notes               String?
  createdByUserId     String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company             Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department          Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation         Designation?           @relation(fields: [designationId], references: [id], onDelete: SetNull)
  grade               Grade?                 @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  businessUnit        BusinessUnit?          @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  division            Division?              @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  location            Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  costCenter          CostCenter?            @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  reportingManager    Employee?              @relation("ReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports       Employee[]             @relation("ReportingManager")
  createdByUser       User                   @relation("EmployeesCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  payslips            Payslip[]
  attendanceRecords   AttendanceRecord[]
  leaveRequests       LeaveRequest[]
  changeRecords       EmployeeChangeRecord[]
  exitProcess         ExitProcess?
  expenseClaims       ExpenseClaim[]
  loans               EmployeeLoan[]
  onboardingChecklist OnboardingChecklist?

  @@unique([workspaceId, employeeCode])
  @@index([workspaceId, status])
}

// Grade/BusinessUnit/Division/Location/CostCenter are flat, workspace-scoped
// pick-lists — same shape and same "no hierarchy" rationale as Department
// (see its comment above Designation). Grade carries an optional numeric
// `level` purely for UI sort order (lower = more senior); it isn't used in
// any calculation.
model Grade {
  id          String     @id @default(uuid())
  tenantId    String
  companyId   String
  workspaceId String
  name        String
  level       Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([workspaceId, name])
}

model BusinessUnit {
  id          String     @id @default(uuid())
  tenantId    String
  companyId   String
  workspaceId String
  name        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([workspaceId, name])
}

model Division {
  id          String     @id @default(uuid())
  tenantId    String
  companyId   String
  workspaceId String
  name        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([workspaceId, name])
}

model Location {
  id          String     @id @default(uuid())
  tenantId    String
  companyId   String
  workspaceId String
  name        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([workspaceId, name])
}

model CostCenter {
  id          String     @id @default(uuid())
  tenantId    String
  companyId   String
  workspaceId String
  name        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([workspaceId, name])
}

model AttendanceRecord {
  id              String           @id @default(uuid())
  tenantId        String
  companyId       String
  workspaceId     String
  employeeId      String
  attendanceDate  DateTime         @db.Date
  status          AttendanceStatus @default(PRESENT)
  checkIn         String?
  checkOut        String?
  lateMinutes     Int              @default(0)
  overtimeMinutes Int              @default(0)
  notes           String?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdByUser   User             @relation("AttendanceRecordsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, employeeId, attendanceDate])
  @@index([workspaceId, attendanceDate])
}

// One monthly payroll batch for a workspace. Totals are the sum of its
// payslips, kept denormalized here so the Payroll list doesn't have to
// re-aggregate every payslip row on every page load.
model PayrollRun {
  id               String           @id @default(uuid())
  tenantId         String
  companyId        String
  workspaceId      String
  periodYear       Int
  periodMonth      Int
  totalWorkingDays Decimal          @db.Decimal(5, 2)
  status           PayrollRunStatus @default(DRAFT)
  totalGross       Decimal          @default(0) @db.Decimal(18, 4)
  totalDeduction   Decimal          @default(0) @db.Decimal(18, 4)
  totalNetPayable  Decimal          @default(0) @db.Decimal(18, 4)
  createdByUserId  String
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser    User             @relation("PayrollRunsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  payslips         Payslip[]

  @@unique([workspaceId, periodYear, periodMonth])
  @@index([workspaceId, status])
}

// The salary breakdown snapshot for one employee within one PayrollRun.
// Amounts are frozen at calculation time (not recomputed from the live
// Employee record later) so a subsequent salary revision never rewrites
// history for an already-calculated period.
model Payslip {
  id                     String               @id @default(uuid())
  payrollRunId           String
  employeeId             String
  employeeCode           String
  employeeName           String
  department             String?
  designation            String?
  grossSalary            Decimal              @db.Decimal(18, 4)
  components             Json
  totalWorkingDays       Decimal              @db.Decimal(5, 2)
  presentDays            Decimal              @db.Decimal(5, 2)
  proratedGross          Decimal              @db.Decimal(18, 4)
  providentFund          Decimal              @default(0) @db.Decimal(18, 4)
  employerPfContribution Decimal              @default(0) @db.Decimal(18, 4)
  iouDeduction           Decimal              @default(0) @db.Decimal(18, 4)
  loanDeduction          Decimal              @default(0) @db.Decimal(18, 4)
  fineDeduction          Decimal              @default(0) @db.Decimal(18, 4)
  lunchBillDeduction     Decimal              @default(0) @db.Decimal(18, 4)
  totalDeduction         Decimal              @default(0) @db.Decimal(18, 4)
  netPayable             Decimal              @db.Decimal(18, 4)
  paymentMethod          SalaryPaymentMethod
  paymentStatus          PayslipPaymentStatus @default(PENDING)
  paidAt                 DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  payrollRun             PayrollRun           @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee               Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

// A workspace-managed leave policy: a name and how many days per calendar
// year it entitles every employee to. No per-employee override in this
// version — remaining balance is always `daysPerYear - approved days taken
// this year`, computed on read rather than stored.
model LeaveType {
  id            String         @id @default(uuid())
  tenantId      String
  companyId     String
  workspaceId   String
  name          String
  daysPerYear   Decimal        @db.Decimal(5, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]

  @@unique([workspaceId, name])
}

// One employee's request for one date range under one LeaveType. `totalDays`
// is frozen at submission time (inclusive day count) so a later LeaveType
// day-count change never rewrites the size of an already-decided request.
model LeaveRequest {
  id              String             @id @default(uuid())
  tenantId        String
  companyId       String
  workspaceId     String
  employeeId      String
  leaveTypeId     String
  startDate       DateTime           @db.Date
  endDate         DateTime           @db.Date
  totalDays       Decimal            @db.Decimal(5, 2)
  reason          String?
  status          LeaveRequestStatus @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  createdByUser   User               @relation("LeaveRequestsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  decidedByUser   User?              @relation("LeaveRequestsDecided", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([employeeId, leaveTypeId])
}

// A named work schedule (e.g. "General Shift", "Night Shift"). weeklyOffDays
// is a Json int[] (0=Sunday..6=Saturday) — same "flexible list" approach as
// Employee.salaryComponents, since a business's weekend pattern isn't fixed.
// Not yet linked to Employee — this only manages the shift definitions
// themselves; assigning employees to a shift is a separate future step.
model Shift {
  id                 String    @id @default(uuid())
  tenantId           String
  companyId          String
  workspaceId        String
  name               String
  startTime          String
  endTime            String
  gracePeriodMinutes Int       @default(0)
  weeklyOffDays      Json
  isDefault          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model PayrollSettings {
  id               String    @id @default(uuid())
  tenantId         String
  companyId        String
  workspaceId      String    @unique
  cycleType        String    @default("CALENDAR_MONTH")
  cycleStartDay    Int       @default(1)
  paymentDay       Int       @default(1)
  salaryComponents Json
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([companyId])
}

// A single company holiday. isRecurringYearly repeats the month/day every
// year (e.g. a national holiday) without needing a row re-created annually.
model Holiday {
  id                String    @id @default(uuid())
  tenantId          String
  companyId         String
  workspaceId       String
  name              String
  date              DateTime  @db.Date
  isRecurringYearly Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date, name])
}

enum EmployeeChangeType {
  PROMOTION
  TRANSFER
  DEPARTMENT_CHANGE
  DESIGNATION_CHANGE
  GRADE_CHANGE
  SALARY_REVISION
  REPORTING_MANAGER_CHANGE
  LOCATION_CHANGE
  EMPLOYMENT_TYPE_CHANGE
}

// A dated, reason-tracked log entry for a change to an employee's structural
// record (promotion, transfer, salary revision, etc.) — distinct from just
// editing the Employee row directly, which leaves no trail of what changed,
// when it took effect, or why. previousValue/newValue are freeform display
// strings (e.g. a designation name, a formatted salary figure), not typed
// per changeType, since each change type describes a different kind of value.
model EmployeeChangeRecord {
  id              String             @id @default(uuid())
  tenantId        String
  companyId       String
  workspaceId     String
  employeeId      String
  changeType      EmployeeChangeType
  effectiveDate   DateTime           @db.Date
  previousValue   String?
  newValue        String?
  reason          String?
  createdByUserId String
  createdAt       DateTime           @default(now())
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdByUser   User               @relation("EmployeeChangesCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, employeeId])
}

enum SeparationType {
  RESIGNATION
  TERMINATION
  RETIREMENT
  CONTRACT_EXPIRY
}

enum ExitProcessStatus {
  IN_PROGRESS
  COMPLETED
}

// One exit process per employee (unique employeeId — an employee is only
// ever separating once). Clearance flags are a simple checklist, not a
// multi-step approval workflow; finalSettlementAmount is entered by hand
// (dues/deductions computed outside the system for now, same as IOU/Loan
// deductions in Payslip), not derived from a settlement calculation engine.
model ExitProcess {
  id                    String            @id @default(uuid())
  tenantId              String
  companyId             String
  workspaceId           String
  employeeId            String            @unique
  separationType        SeparationType
  noticeStartDate       DateTime?         @db.Date
  lastWorkingDate       DateTime?         @db.Date
  departmentClearance   Boolean           @default(false)
  assetClearance        Boolean           @default(false)
  financeClearance      Boolean           @default(false)
  hrClearance           Boolean           @default(false)
  finalSettlementAmount Decimal?          @db.Decimal(18, 4)
  exitInterviewNotes    String?
  status                ExitProcessStatus @default(IN_PROGRESS)
  createdByUserId       String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdByUser         User              @relation("ExitProcessesCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
}

enum ExpenseCategory {
  TRAVEL
  MEAL
  TRANSPORTATION
  ACCOMMODATION
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

// A single expense claim by an employee. Deliberately not linked into
// Payroll (no automatic payslip deduction/addition) — reimbursement is
// tracked here only, same "manually entered, not GL-integrated" boundary
// as the rest of Payroll's IOU/Loan/Fine deduction fields.
model ExpenseClaim {
  id              String          @id @default(uuid())
  tenantId        String
  companyId       String
  workspaceId     String
  employeeId      String
  category        ExpenseCategory
  amount          Decimal         @db.Decimal(18, 4)
  expenseDate     DateTime        @db.Date
  description     String?
  status          ExpenseStatus   @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?
  reimbursedAt    DateTime?
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdByUser   User            @relation("ExpenseClaimsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  decidedByUser   User?           @relation("ExpenseClaimsDecided", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
}

enum EmployeeLoanType {
  LOAN
  SALARY_ADVANCE
  EXPENSE_ADVANCE
}

enum EmployeeLoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  SETTLED
}

// remainingBalance is never stored — always principalAmount minus the sum of
// this loan's LoanRepayment rows, computed live on read (same "derive on
// read, never drift" approach as Leave Balance and the Provident Fund
// summary). Not wired into Payroll's loanDeduction/iouDeduction fields —
// those remain manually entered per payroll run; connecting them to an
// employee's actual outstanding balance is a deliberate future step, not
// done here, to avoid changing how Payroll calculation already works.
model EmployeeLoan {
  id              String             @id @default(uuid())
  tenantId        String
  companyId       String
  workspaceId     String
  employeeId      String
  loanType        EmployeeLoanType
  principalAmount Decimal            @db.Decimal(18, 4)
  reason          String?
  applicationDate DateTime           @db.Date
  status          EmployeeLoanStatus @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  disbursedAt     DateTime?
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdByUser   User               @relation("EmployeeLoansCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  decidedByUser   User?              @relation("EmployeeLoansDecided", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  repayments      LoanRepayment[]

  @@index([workspaceId, status])
}

model LoanRepayment {
  id              String       @id @default(uuid())
  loanId          String
  amount          Decimal      @db.Decimal(18, 4)
  paidDate        DateTime     @db.Date
  note            String?
  createdByUserId String
  createdAt       DateTime     @default(now())
  loan            EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdByUser   User         @relation("LoanRepaymentsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([loanId])
}

enum JobOpeningStatus {
  OPEN
  ON_HOLD
  CLOSED
}

model JobOpening {
  id                String           @id @default(uuid())
  tenantId          String
  companyId         String
  workspaceId       String
  title             String
  departmentId      String?
  designationId     String?
  numberOfPositions Int              @default(1)
  status            JobOpeningStatus @default(OPEN)
  description       String?
  createdByUserId   String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department        Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation       Designation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  createdByUser     User             @relation("JobOpeningsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  applications      JobApplication[]

  @@index([workspaceId, status])
}

// The candidate database / talent pool — one row per person, reusable across
// multiple JobOpenings via separate JobApplication rows (see @@unique below).
model Candidate {
  id              String           @id @default(uuid())
  tenantId        String
  companyId       String
  workspaceId     String
  name            String
  email           String?
  phone           String?
  source          String?
  resumeNote      String?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser   User             @relation("CandidatesCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  applications    JobApplication[]

  @@index([workspaceId])
}

// The recruitment pipeline is modeled as one linear `stage` field rather than
// separate models per step (Screening/Shortlisting/Interview/Assessment/
// Reference Check/Selection/Offer) — those are stages of the SAME
// application, not separate entities, so a single mutable status plus a few
// stage-specific optional fields (interview notes, assessment score, offered
// salary) covers the spec without a table-per-stage. Hiring is a manual,
// separate step (HR creates the Employee normally via Add Employee) rather
// than an automatic conversion from OFFER_ACCEPTED.
enum ApplicationStage {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  ASSESSMENT
  REFERENCE_CHECK
  SELECTED
  OFFER_SENT
  OFFER_ACCEPTED
  REJECTED
  WITHDRAWN
}

model JobApplication {
  id                  String           @id @default(uuid())
  tenantId            String
  companyId           String
  workspaceId         String
  candidateId         String
  jobOpeningId        String
  stage               ApplicationStage @default(APPLIED)
  appliedDate         DateTime         @db.Date
  interviewDate       DateTime?
  interviewNotes      String?
  assessmentScore     Decimal?         @db.Decimal(5, 2)
  referenceCheckNotes String?
  offeredSalary       Decimal?         @db.Decimal(18, 4)
  offerDate           DateTime?        @db.Date
  notes               String?
  createdByUserId     String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidate           Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpening          JobOpening       @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  createdByUser       User             @relation("JobApplicationsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([candidateId, jobOpeningId])
  @@index([workspaceId, stage])
}

// One checklist per employee, auto-created on first read (no explicit "start
// onboarding" action needed — every employee has one from day one). Plain
// boolean checklist items, same pattern as ExitProcess's clearance flags.
model OnboardingChecklist {
  id                   String    @id @default(uuid())
  tenantId             String
  companyId            String
  workspaceId          String
  employeeId           String    @unique
  documentsCollected   Boolean   @default(false)
  joiningFormSubmitted Boolean   @default(false)
  idCardIssued         Boolean   @default(false)
  emailAccountCreated  Boolean   @default(false)
  accessGranted        Boolean   @default(false)
  deviceAllocated      Boolean   @default(false)
  workspaceAllocated   Boolean   @default(false)
  probationReviewDate  DateTime? @db.Date
  probationReviewNotes String?
  confirmedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ============================================================================
// LC (Letter of Credit) Import & Product-wise Landed Cost Module
//
// LcMaster/LcCostHead carry tenant/company/workspace scoping directly (same
// as FixedAsset); every other row scopes transitively through its parent
// (LcItem/LcShipment/LcCostEntry/LcGrn -> lcId -> LcMaster.workspaceId),
// matching the FixedAssetDepreciationEntry convention of not repeating tenant
// columns on child rows.
// ============================================================================

enum LcStatus {
  DRAFT
  ACTIVE
  COSTING_PENDING
  ALLOCATION_PENDING
  READY_TO_FINALIZE
  FINALIZED
  CLOSED
  CANCELLED
}

// Fixed set of landed-cost expense categories (matches the spec's UI columns
// and LcLandedCostItem's per-category breakdown). Cost HEADS within a
// category are configurable (LcCostHead) — the category itself is not, since
// the landed-cost formula and reports are structured around these buckets.
enum LcCostCategory {
  LC_BANKING
  ORIGIN
  FREIGHT
  INSURANCE
  CUSTOMS
  TAX
  CNF
  PORT
  DESTINATION_TRANSPORT
  LOCAL
  OTHER
}

enum LcAllocationBasis {
  PURCHASE_VALUE
  USD_VALUE
  QUANTITY
  WEIGHT
  CBM
  EQUAL
}

enum LcAllocationMode {
  AUTO
  MANUAL_AMOUNT
  MANUAL_PERCENTAGE
  HYBRID
  DIRECT_PRODUCT
}

enum LcLandedCostStatus {
  DRAFT
  FINALIZED
}

enum LcProfitMode {
  PERCENTAGE
  FIXED
}

model LcMaster {
  id                     String    @id @default(uuid())
  tenantId               String
  companyId              String
  workspaceId            String
  lcNumber               String
  lcDate                 DateTime  @db.Date
  supplierId             String?
  supplierName           String
  supplierCountry        String?
  purchaseOrderRef       String?
  piReference            String?
  bankName               String?
  bankBranch             String?
  lcType                 String?
  currency               String    @default("USD")
  exchangeRate           Decimal   @db.Decimal(18, 6)
  incoterm               String?
  originCountry          String?
  originPort             String?
  destinationPort        String?
  destinationWarehouseId String?
  lastShipmentDate       DateTime? @db.Date
  expiryDate             DateTime? @db.Date
  remarks                String?
  purchasePaymentStatus  String    @default("UNPAID")
  purchasePaidAmount     Decimal   @default(0) @db.Decimal(18, 4)
  paymentReference       String?
  paymentAllocations     Json?
  purchaseGlVoucherId    String?
  paymentGlVoucherIds    Json?
  status                 LcStatus  @default(DRAFT)
  createdByUserId        String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company              Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier             Party?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  destinationWarehouse Warehouse?           @relation(fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  createdByUser        User                 @relation("LcMasterCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items                LcItem[]
  inventoryPostings    LcInventoryPosting[]
  shipments            LcShipment[]
  costEntries          LcCostEntry[]
  grns                 LcGrn[]
  statusHistory        LcStatusHistory[]
  landedCost           LcLandedCost?

  @@unique([workspaceId, lcNumber])
  @@index([workspaceId, status])
  @@index([supplierId])
}

model LcStatusHistory {
  id              String    @id @default(uuid())
  lcId            String
  fromStatus      LcStatus?
  toStatus        LcStatus
  reason          String?
  changedByUserId String
  changedAt       DateTime  @default(now())

  lc            LcMaster @relation(fields: [lcId], references: [id], onDelete: Cascade)
  changedByUser User     @relation("LcStatusHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([lcId])
}

model LcItem {
  id                     String        @id @default(uuid())
  lcId                   String
  inventoryItemId        String?
  productName            String
  description            String?
  unit                   String        @default("pcs")
  quantity               Decimal       @db.Decimal(18, 4)
  usdUnitPrice           Decimal       @db.Decimal(18, 4)
  exchangeRate           Decimal       @db.Decimal(18, 6)
  calculatedBdtUnitPrice Decimal       @db.Decimal(18, 4)
  acceptedBdtUnitPrice   Decimal?      @db.Decimal(18, 4)
  totalPurchaseCostBdt   Decimal       @db.Decimal(18, 4)
  weight                 Decimal?      @db.Decimal(18, 4)
  cbm                    Decimal?      @db.Decimal(18, 4)
  hsCode                 String?
  receivedQuantity       Decimal       @default(0) @db.Decimal(18, 4)
  landedCostAmount       Decimal?      @db.Decimal(18, 4)
  landedCostPerUnit      Decimal?      @db.Decimal(18, 4)
  profitMode             LcProfitMode?
  profitValue            Decimal?      @db.Decimal(18, 4)
  sortOrder              Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  lc               LcMaster            @relation(fields: [lcId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  allocations      LcCostAllocation[]
  grnItems         LcGrnItem[]
  landedCostItem   LcLandedCostItem?
  inventoryPosting LcInventoryPosting?

  @@index([lcId])
  @@index([inventoryItemId])
}

model LcInventoryPosting {
  id              String   @id @default(uuid())
  lcId            String
  lcItemId        String   @unique
  warehouseId     String
  stockMovementId String?  @unique
  quantity        Decimal  @db.Decimal(18, 4)
  unitCost        Decimal  @db.Decimal(24, 6)
  totalCost       Decimal  @db.Decimal(24, 6)
  postedByUserId  String
  postedAt        DateTime @default(now())

  lc            LcMaster       @relation(fields: [lcId], references: [id], onDelete: Restrict)
  lcItem        LcItem         @relation(fields: [lcItemId], references: [id], onDelete: Restrict)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  stockMovement StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  postedBy      User           @relation(fields: [postedByUserId], references: [id], onDelete: Restrict)

  @@index([lcId, postedAt])
  @@index([warehouseId, postedAt])
}

model LcShipment {
  id              String    @id @default(uuid())
  lcId            String
  transportMode   String?   @default("SEA")
  shipmentNumber  String?
  blAwbNumber     String?
  etd             DateTime? @db.Date
  eta             DateTime? @db.Date
  containerNumber String?
  forwarderName   String?
  shippingLine    String?
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lc          LcMaster      @relation(fields: [lcId], references: [id], onDelete: Cascade)
  costEntries LcCostEntry[]

  @@index([lcId])
}

// Configurable cost-head catalog (spec: "Do NOT hard-code the system so new
// cost types require code changes"). Seeded per-workspace with the sample
// dataset's named cost heads (LC Cost, Supplier Warehouse -> Port, ...) but
// fully user-editable/addable from Configuration > Cost Heads.
model LcCostHead {
  id                        String             @id @default(uuid())
  tenantId                  String
  companyId                 String
  workspaceId               String
  name                      String
  code                      String
  category                  LcCostCategory
  defaultCurrency           String             @default("BDT")
  defaultAllocationMethod   LcAllocationBasis  @default(PURCHASE_VALUE)
  fallbackAllocationMethod  LcAllocationBasis?
  /**
   * UX hint only (e.g. Custom Duty recommends DIRECT_PRODUCT) — the actual
   * mode used is always LcCostEntry.allocationMode, set per entry.
   */
  recommendedAllocationMode LcAllocationMode?
  includeInLandedCost       Boolean            @default(true)
  manualOverrideAllowed     Boolean            @default(true)
  glAccountId               String?
  isActive                  Boolean            @default(true)
  isSystem                  Boolean            @default(false)
  sortOrder                 Int                @default(0)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  glAccount   Account?      @relation(fields: [glAccountId], references: [id], onDelete: SetNull)
  costEntries LcCostEntry[]

  @@unique([workspaceId, code])
  @@index([workspaceId, category, isActive])
}

model LcCostEntry {
  id                  String             @id @default(uuid())
  lcId                String
  costHeadId          String
  shipmentId          String?
  vendorName          String?
  invoiceNumber       String?
  invoiceDate         DateTime?          @db.Date
  currency            String             @default("BDT")
  foreignAmount       Decimal?           @db.Decimal(18, 4)
  exchangeRate        Decimal?           @db.Decimal(18, 6)
  bdtAmount           Decimal            @db.Decimal(18, 4)
  allocationMode      LcAllocationMode   @default(AUTO)
  allocationBasis     LcAllocationBasis?
  includeInLandedCost Boolean            @default(true)
  attachmentUrl       String?            @db.Text
  attachmentName      String?
  remarks             String?
  paymentMethod       String?
  creditPayeeName     String?
  paymentAllocations  Json?
  paymentGlVoucherId  String?
  isLocked            Boolean            @default(false)
  createdByUserId     String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  lc            LcMaster           @relation(fields: [lcId], references: [id], onDelete: Cascade)
  costHead      LcCostHead         @relation(fields: [costHeadId], references: [id], onDelete: Restrict)
  shipment      LcShipment?        @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  createdByUser User               @relation("LcCostEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  allocations   LcCostAllocation[]

  @@index([lcId])
  @@index([costHeadId])
}

// One row per (cost entry, product) pair — the allocation engine's core unit.
// isDirect=true means this cost was assigned straight to this product
// (DIRECT_PRODUCT mode) with no proportional basis math. The override-audit
// fields snapshot what AUTO would have suggested whenever a user overrides it,
// per the spec's "Manual Override Audit" requirement.
model LcCostAllocation {
  id                  String             @id @default(uuid())
  costEntryId         String
  lcItemId            String
  basisValue          Decimal            @default(0) @db.Decimal(18, 4)
  basisPercentage     Decimal            @default(0) @db.Decimal(9, 6)
  autoSuggestedAmount Decimal            @default(0) @db.Decimal(18, 4)
  manualAmount        Decimal?           @db.Decimal(18, 4)
  finalAmount         Decimal            @db.Decimal(18, 4)
  isDirect            Boolean            @default(false)
  isOverridden        Boolean            @default(false)
  overrideReason      String?
  originalMode        LcAllocationMode?
  originalBasis       LcAllocationBasis?
  originalAutoAmount  Decimal?           @db.Decimal(18, 4)
  changedByUserId     String?
  changedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  costEntry     LcCostEntry @relation(fields: [costEntryId], references: [id], onDelete: Cascade)
  lcItem        LcItem      @relation(fields: [lcItemId], references: [id], onDelete: Cascade)
  changedByUser User?       @relation("LcCostAllocationChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@unique([costEntryId, lcItemId])
  @@index([lcItemId])
}

model LcGrn {
  id              String   @id @default(uuid())
  lcId            String
  grnNumber       String
  receivedDate    DateTime @db.Date
  warehouseId     String?
  remarks         String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lc            LcMaster    @relation(fields: [lcId], references: [id], onDelete: Cascade)
  warehouse     Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdByUser User        @relation("LcGrnCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items         LcGrnItem[]

  @@unique([lcId, grnNumber])
  @@index([lcId])
}

model LcGrnItem {
  id               String   @id @default(uuid())
  grnId            String
  lcItemId         String
  expectedQuantity Decimal  @db.Decimal(18, 4)
  receivedQuantity Decimal  @db.Decimal(18, 4)
  shortQuantity    Decimal  @default(0) @db.Decimal(18, 4)
  excessQuantity   Decimal  @default(0) @db.Decimal(18, 4)
  damagedQuantity  Decimal  @default(0) @db.Decimal(18, 4)
  rejectedQuantity Decimal  @default(0) @db.Decimal(18, 4)
  createdAt        DateTime @default(now())

  grn    LcGrn  @relation(fields: [grnId], references: [id], onDelete: Cascade)
  lcItem LcItem @relation(fields: [lcItemId], references: [id], onDelete: Cascade)

  @@unique([grnId, lcItemId])
  @@index([lcItemId])
}

// Snapshot of the finalized (or draft-preview) landed-cost computation for one
// LC. Recomputed freely while status=DRAFT; frozen once FINALIZED (see
// LcService.finalize) — later corrections go through reopen (reopenedAt/
// reopenReason) rather than silent overwrite, per the spec's audit rules.
model LcLandedCost {
  id                   String             @id @default(uuid())
  lcId                 String             @unique
  purchaseCostTotal    Decimal            @default(0) @db.Decimal(18, 4)
  importCostTotal      Decimal            @default(0) @db.Decimal(18, 4)
  landedCostTotal      Decimal            @default(0) @db.Decimal(18, 4)
  allocationDifference Decimal            @default(0) @db.Decimal(18, 4)
  status               LcLandedCostStatus @default(DRAFT)
  finalizedByUserId    String?
  finalizedAt          DateTime?
  reopenedByUserId     String?
  reopenedAt           DateTime?
  reopenReason         String?
  glVoucherId          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  lc    LcMaster           @relation(fields: [lcId], references: [id], onDelete: Cascade)
  items LcLandedCostItem[]

  @@index([lcId])
}

model LcLandedCostItem {
  id                       String  @id @default(uuid())
  landedCostId             String
  lcItemId                 String  @unique
  purchaseCost             Decimal @default(0) @db.Decimal(18, 4)
  lcBankingCost            Decimal @default(0) @db.Decimal(18, 4)
  originCost               Decimal @default(0) @db.Decimal(18, 4)
  freightCost              Decimal @default(0) @db.Decimal(18, 4)
  insuranceCost            Decimal @default(0) @db.Decimal(18, 4)
  customsCost              Decimal @default(0) @db.Decimal(18, 4)
  taxCost                  Decimal @default(0) @db.Decimal(18, 4)
  cnfCost                  Decimal @default(0) @db.Decimal(18, 4)
  portCost                 Decimal @default(0) @db.Decimal(18, 4)
  destinationTransportCost Decimal @default(0) @db.Decimal(18, 4)
  localCost                Decimal @default(0) @db.Decimal(18, 4)
  otherCost                Decimal @default(0) @db.Decimal(18, 4)
  totalLandedCost          Decimal @default(0) @db.Decimal(18, 4)
  receivedQuantity         Decimal @default(0) @db.Decimal(18, 4)
  unitLandedCost           Decimal @default(0) @db.Decimal(18, 4)

  landedCost LcLandedCost @relation(fields: [landedCostId], references: [id], onDelete: Cascade)
  lcItem     LcItem       @relation(fields: [lcItemId], references: [id], onDelete: Cascade)

  @@index([landedCostId])
}

// ============================================================================
// Manufacturing
//
// All manufacturing rows are additive to the existing inventory/accounting
// backbone. Master and document roots carry tenant/company/workspace scope;
// child rows inherit scope through their parent. Posted inventory/accounting
// records are linked rather than duplicated, and no business/demo rows are
// created by this schema.
// ============================================================================

enum ManufacturingMode {
  GENERAL
  PHARMACEUTICAL
  HYBRID
}

enum ManufacturingItemRole {
  RAW_MATERIAL
  PACKAGING_MATERIAL
  INTERMEDIATE
  BULK
  FINISHED_GOOD
  BY_PRODUCT
  CONSUMABLE
}

enum ManufacturingMakeBuy {
  MAKE
  BUY
  BOTH
}

enum ManufacturingLocationDisposition {
  RELEASED
  RESERVED
  STAGING
  WIP
  QC_HOLD
  REWORK
  REJECTED
  SCRAP
}

enum ManufacturingVersionStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum ManufacturingPlanStatus {
  DRAFT
  APPROVED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CLOSED
}

enum ManufacturingLotStatus {
  PLANNED
  RELEASED
  IN_PRODUCTION
  QC_HOLD
  COMPLETED
  CANCELLED
  CLOSED
}

enum ManufacturingMrpRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  SUPERSEDED
}

enum ManufacturingOrderType {
  ASSEMBLY
  PHARMACEUTICAL
  PACKAGING
  REWORK
  REPROCESSING
  SUBCONTRACT
}

enum ManufacturingOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RESERVED
  ISSUED
  IN_PRODUCTION
  QC_HOLD
  QA_RELEASED
  COMPLETED
  CLOSED
  CANCELLED
}

enum ManufacturingMaterialStatus {
