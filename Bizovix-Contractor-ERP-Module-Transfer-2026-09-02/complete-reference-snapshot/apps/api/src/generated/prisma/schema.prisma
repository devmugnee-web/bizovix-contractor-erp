  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accounts  Account[]

  @@unique([companyId, code])
}

model VoucherType {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String
  code      String
  name      String
  shortCode String
  isSystem  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
}

model Account {
  id                                           String                           @id @default(uuid())
  tenantId                                     String
  companyId                                    String
  accountGroupId                               String?
  parentId                                     String?
  level                                        AccountLevel                     @default(LEDGER)
  sortOrder                                    Int                              @default(0)
  code                                         String
  name                                         String
  /// Stable internal ownership key for module-provisioned accounts. Captions
  /// remain editable display data; posting identity is the Account id and this
  /// company-scoped role. NULL means the account is user-managed.
  managedRole                                  String?
  nature                                       AccountNature
  isSystem                                     Boolean                          @default(false)
  isControlAccount                             Boolean                          @default(false)
  requiresItemDetails                          Boolean                          @default(true)
  openingBalance                               Decimal                          @default(0) @db.Decimal(18, 4)
  openingBalanceDate                           DateTime?                        @db.Date
  openingBalanceSourceAccountId                String?
  openingBalanceSources                        Json?
  bankDetails                                  Json?
  /// Whether this ledger's details (bank name, account number, etc.) should be
  /// printed on customer-facing invoices — a display preference, not part of
  /// the bank's own identifying details, so it sits in its own column rather
  /// than inside bankDetails.
  printOnInvoices                              Boolean                          @default(false)
  status                                       AccountStatus                    @default(ACTIVE)
  createdAt                                    DateTime                         @default(now())
  updatedAt                                    DateTime                         @updatedAt
  tenant                                       Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                                      Company                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountGroup                                 AccountGroup?                    @relation(fields: [accountGroupId], references: [id], onDelete: Restrict)
  parent                                       Account?                         @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                                     Account[]                        @relation("AccountHierarchy")
  voucherEntryLines                            VoucherEntryLine[]
  managedParty                                 Party?                           @relation("PartyLedgerAccount")
  ledgerItems                                  LedgerItem[]
  fixedAsset                                   FixedAsset?
  assetCategoryAssetLedgerOf                   AssetCategory[]                  @relation("AssetCategoryAssetLedger")
  assetCategoryAccumulatedDepreciationLedgerOf AssetCategory[]                  @relation("AssetCategoryAccumulatedDepreciationLedger")
  assetCategoryDepreciationExpenseLedgerOf     AssetCategory[]                  @relation("AssetCategoryDepreciationExpenseLedger")
  lcCostHeads                                  LcCostHead[]
  manufacturingCostDriversClearing             ManufacturingCostDriver[]
  manufacturingStandardCostLinesClearing       ManufacturingStandardCostLine[]
  manufacturingActualCostPostingsWip           ManufacturingActualCostPosting[] @relation("ManufacturingActualCostPostingWipAccount")
  manufacturingActualCostPostingsClearing      ManufacturingActualCostPosting[] @relation("ManufacturingActualCostPostingClearingAccount")

  @@unique([companyId, code])
  @@unique([companyId, managedRole])
  @@index([companyId, isControlAccount])
  @@index([companyId, status])
  @@index([companyId, parentId])
  @@index([companyId, level])
}

// A predefined list of item names (with a unit each) scoped to one specific
// Ledger — e.g. the "Office Stationery" ledger might list "A4 Paper" (ream),
// "Pen" (pcs), "Stapler" (pcs). Deliberately separate from the company-wide
// InventoryItem master: these are lightweight expense-entry labels, not
// stock-tracked inventory.
model LedgerItem {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String
  accountId String
  name      String
  unit      String   @default("pcs")
  sortOrder Int      @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name])
  @@index([companyId])
  @@index([accountId])
}

// A category (or subcategory, via parentId — e.g. "Vehicles" > "Delivery Van")
// that Fixed Assets file under. Each category can carry its own GL mapping
// (a dedicated Fixed Asset / Accumulated Depreciation / Depreciation Expense
// ledger set, e.g. "Fixed Assets: Vehicles") and defaults that a new asset in
// that category inherits — mirrors how Account itself nests Category under
// Category to unlimited depth (schema.prisma, AccountLevel), so a subcategory
// is simply a category with a parent rather than a whole separate concept.
model AssetCategory {
  id                              String                       @id @default(uuid())
  tenantId                        String
  companyId                       String
  parentId                        String?
  name                            String
  code                            String
  defaultUsefulLifeMonths         Int?
  defaultSalvageValue             Decimal?                     @db.Decimal(18, 4)
  defaultDepreciationMethod       FixedAssetDepreciationMethod @default(STRAIGHT_LINE)
  assetLedgerId                   String?
  accumulatedDepreciationLedgerId String?
  depreciationExpenseLedgerId     String?
  isActive                        Boolean                      @default(true)
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt
  tenant                          Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                         Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent                          AssetCategory?               @relation("AssetCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                        AssetCategory[]              @relation("AssetCategoryHierarchy")
  assetLedger                     Account?                     @relation("AssetCategoryAssetLedger", fields: [assetLedgerId], references: [id], onDelete: Restrict)
  accumulatedDepreciationLedger   Account?                     @relation("AssetCategoryAccumulatedDepreciationLedger", fields: [accumulatedDepreciationLedgerId], references: [id], onDelete: Restrict)
  depreciationExpenseLedger       Account?                     @relation("AssetCategoryDepreciationExpenseLedger", fields: [depreciationExpenseLedgerId], references: [id], onDelete: Restrict)
  assets                          FixedAsset[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
}

// A fixed asset register entry, linked 1:1 to its own dedicated Account
// ledger (level LEDGER, nature ASSET, filed under its AssetCategory's own
// "Fixed Assets: <Category>" parent) so its cost sits in the Chart of
// Accounts and flows into the Balance Sheet through the existing tree-walk
// with no special casing. Accumulated depreciation is tracked per-asset here
// (not as one ledger per asset) — the category's shared "Accumulated
// Depreciation" ledger holds that category's contra-asset total, while this
// table is the subsidiary detail behind it, the same relationship LedgerItem
// has to its parent ledger.
model FixedAsset {
  id                       String                        @id @default(uuid())
  tenantId                 String
  companyId                String
  workspaceId              String
  assetLedgerId            String                        @unique
  assetCode                String
  categoryId               String?
  supplierId               String?
  name                     String
  category                 String?
  location                 String?
  department               String?
  assignedToName           String?
  brand                    String?
  model                    String?
  manufacturer             String?
  serialNumber             String?
  registrationNumber       String?
  condition                AssetCondition                @default(GOOD)
  operationalStatus        AssetOperationalStatus        @default(AVAILABLE)
  acquisitionType          AssetAcquisitionType          @default(DIRECT_PURCHASE)
  notes                    String?
  purchaseDate             DateTime                      @db.Date
  purchaseCost             Decimal                       @db.Decimal(18, 4)
  transportationCost       Decimal                       @default(0) @db.Decimal(18, 4)
  installationCost         Decimal                       @default(0) @db.Decimal(18, 4)
  importDuty               Decimal                       @default(0) @db.Decimal(18, 4)
  registrationCost         Decimal                       @default(0) @db.Decimal(18, 4)
  otherCapitalizedCost     Decimal                       @default(0) @db.Decimal(18, 4)
  discountAmount           Decimal                       @default(0) @db.Decimal(18, 4)
  capitalizedCost          Decimal                       @db.Decimal(18, 4)
  salvageValue             Decimal                       @default(0) @db.Decimal(18, 4)
  usefulLifeMonths         Int
  depreciationMethod       FixedAssetDepreciationMethod  @default(STRAIGHT_LINE)
  useManualDepreciation    Boolean                       @default(false)
  manualDepreciationAmount Decimal?                      @db.Decimal(18, 4)
  status                   FixedAssetStatus              @default(ACTIVE)
  disposalDate             DateTime?                     @db.Date
  disposalProceeds         Decimal?                      @db.Decimal(18, 4)
  createdByUserId          String
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  tenant                   Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                  Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace                Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assetLedger              Account                       @relation(fields: [assetLedgerId], references: [id], onDelete: Restrict)
  assetCategory            AssetCategory?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier                 Party?                        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdByUser            User                          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  depreciationEntries      FixedAssetDepreciationEntry[]

  @@unique([companyId, assetCode])
  @@index([companyId])
  @@index([workspaceId])
  @@index([companyId, status])
  @@index([categoryId])
  @@index([supplierId])
}

enum AssetCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

// Kept deliberately separate from FixedAssetStatus (the financial/lifecycle
// status: ACTIVE/DISPOSED/FULLY_DEPRECIATED) — one overloaded status field
// can't answer both "is this asset in use right now" and "is it still on the
// books" at once (e.g. a DISPOSED asset was necessarily AVAILABLE or RETIRED
// operationally right before disposal, not some third disposal-specific
// operational state).
enum AssetOperationalStatus {
  AVAILABLE
  ASSIGNED
  ACTIVE
  UNDER_MAINTENANCE
  DAMAGED
  LOST
  RETIRED
}

enum AssetAcquisitionType {
  DIRECT_PURCHASE
  PURCHASE_ORDER
  OPENING_ASSET
  DONATION
  TRANSFER_IN
  INTERNALLY_CONSTRUCTED
  OTHER
}

// One posted depreciation period for one asset. `voucherEntryId` links to the
// real EXPENSE voucher (Debit: Depreciation Expense, Credit: Accumulated
// Depreciation) that carries the actual accounting effect — this row is just
// the asset-level record of which periods have already been posted, so a
// period can never be depreciated twice.
model FixedAssetDepreciationEntry {
  id             String       @id @default(uuid())
  fixedAssetId   String
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  amount         Decimal      @db.Decimal(18, 4)
  voucherEntryId String       @unique
  createdAt      DateTime     @default(now())
  fixedAsset     FixedAsset   @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)
  voucherEntry   VoucherEntry @relation(fields: [voucherEntryId], references: [id], onDelete: Restrict)

  @@unique([fixedAssetId, periodEnd])
  @@index([fixedAssetId])
}

enum FixedAssetDepreciationMethod {
  STRAIGHT_LINE
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
  FULLY_DEPRECIATED
}

