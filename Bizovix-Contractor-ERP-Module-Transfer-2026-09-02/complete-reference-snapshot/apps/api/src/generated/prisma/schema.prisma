model StockMovement {
  id                             String                        @id @default(uuid())
  tenantId                       String
  companyId                      String
  workspaceId                    String
  warehouseId                    String
  inventoryItemId                String
  transactionType                String
  transactionId                  String
  transactionLineId              String
  referenceNo                    String?
  movementType                   StockMovementType
  quantity                       Decimal                       @db.Decimal(18, 4)
  unit                           String
  unitConversion                 Decimal?                      @db.Decimal(18, 4)
  /// Source rate supplied by an acquisition/adjustment. Issues are costed by
  /// the moving-average replay and therefore normally keep this null.
  inputUnitCost                  Decimal?                      @db.Decimal(24, 6)
  /// Perpetual moving-weighted-average result for this movement.
  unitCost                       Decimal                       @default(0) @db.Decimal(24, 6)
  movementValue                  Decimal                       @default(0) @db.Decimal(24, 6)
  balanceQuantity                Decimal                       @default(0) @db.Decimal(24, 6)
  balanceValue                   Decimal                       @default(0) @db.Decimal(24, 6)
  averageCost                    Decimal                       @default(0) @db.Decimal(24, 6)
  costingVersion                 Int                           @default(0)
  batchNumber                    String?
  manufacturedAt                 DateTime?
  expiresAt                      DateTime?
  transactionDate                DateTime
  postedByUserId                 String?
  reversalOfId                   String?
  idempotencyKey                 String
  /// Audit-preserving exclusion marker. Invalid legacy/orphan movements are
  /// never hard-deleted; valuation and operational reads ignore voided rows.
  voidedAt                       DateTime?
  voidReason                     String?
  createdAt                      DateTime                      @default(now())
  tenant                         Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                        Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace                      Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  warehouse                      Warehouse                     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inventoryItem                  InventoryItem                 @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  postedBy                       User?                         @relation(fields: [postedByUserId], references: [id], onDelete: SetNull)
  reversalOf                     StockMovement?                @relation("StockMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals                      StockMovement[]               @relation("StockMovementReversal")
  costRevaluations               InventoryCostRevaluation[]
  lcInventoryPosting             LcInventoryPosting?
  manufacturingTransactionLineId String?
  manufacturingTransactionLine   ManufacturingTransactionLine? @relation(fields: [manufacturingTransactionLineId], references: [id], onDelete: Restrict)
  manufacturingCostAllocations   ManufacturingCostAllocation[]
  manufacturingPostingLinks      ManufacturingPostingLink[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, voidedAt])
  @@index([workspaceId, costingVersion])
  @@index([workspaceId, warehouseId, inventoryItemId, transactionDate])
  @@index([transactionType, transactionId])
  @@index([inventoryItemId, transactionDate])
  @@index([workspaceId, inventoryItemId, expiresAt])
  @@index([manufacturingTransactionLineId])
}

/// A Purchase Bill converted from a Receipt Note must not create a second
/// quantity movement. This record overlays the billed net acquisition cost on
/// the original receipt movement and keeps the adjustment independently
/// auditable/reversible.
model InventoryCostRevaluation {
  id                     String               @id @default(uuid())
  tenantId               String
  companyId              String
  workspaceId            String
  warehouseId            String
  inventoryItemId        String
  sourceMovementId       String
  sourceInventoryLineId  String
  billingVoucherId       String
  billingInventoryLineId String
  quantity               Decimal              @db.Decimal(18, 4)
  sourceUnitCost         Decimal              @db.Decimal(24, 6)
  revisedUnitCost        Decimal              @db.Decimal(24, 6)
  varianceAmount         Decimal              @db.Decimal(24, 6)
  effectiveDate          DateTime
  isActive               Boolean              @default(true)
  reversedAt             DateTime?
  idempotencyKey         String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace              Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  warehouse              Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inventoryItem          InventoryItem        @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  sourceMovement         StockMovement        @relation(fields: [sourceMovementId], references: [id], onDelete: Restrict)
  sourceInventoryLine    VoucherInventoryItem @relation("InventoryRevaluationSourceLine", fields: [sourceInventoryLineId], references: [id], onDelete: Restrict)
  billingVoucher         VoucherEntry         @relation(fields: [billingVoucherId], references: [id], onDelete: Restrict)
  billingInventoryLine   VoucherInventoryItem @relation("InventoryRevaluationBillingLine", fields: [billingInventoryLineId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey])
  @@unique([billingVoucherId, billingInventoryLineId, sourceMovementId])
  @@index([workspaceId, inventoryItemId, isActive])
  @@index([sourceMovementId, isActive])
  @@index([billingVoucherId, isActive])
}

