  @@unique([versionId, sequence])
  @@index([versionId, costType])
  @@index([costDriverId])
  @@index([clearingAccountId])
}

/// One immutable posted actual-cost document. Its voucher is always balanced
/// Dr WIP / Cr the driver's configured clearing ledger at the currency minor
/// unit; higher precision is retained only for rate/quantity evidence.
model ManufacturingActualCostPosting {
  id                  String                       @id @default(uuid())
  tenantId            String
  companyId           String
  workspaceId         String
  orderId             String
  costDriverId        String
  costType            ManufacturingCostType
  driverBasis         ManufacturingCostDriverBasis
  description         String
  basisQuantity       Decimal                      @default(1) @db.Decimal(18, 6)
  rate                Decimal                      @db.Decimal(24, 8)
  amount              Decimal                      @db.Decimal(24, 6)
  wipAccountId        String
  clearingAccountId   String
  voucherEntryId      String                       @unique
  finalizedSnapshotId String?
  transactionDate     DateTime
  referenceNo         String?
  note                String?
  idempotencyKey      String
  createdByUserId     String
  createdAt           DateTime                     @default(now())
  tenant              Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company             Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace           Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order               ManufacturingOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  costDriver          ManufacturingCostDriver      @relation(fields: [costDriverId], references: [id], onDelete: Restrict)
  wipAccount          Account                      @relation("ManufacturingActualCostPostingWipAccount", fields: [wipAccountId], references: [id], onDelete: Restrict)
  clearingAccount     Account                      @relation("ManufacturingActualCostPostingClearingAccount", fields: [clearingAccountId], references: [id], onDelete: Restrict)
  voucherEntry        VoucherEntry                 @relation(fields: [voucherEntryId], references: [id], onDelete: Restrict)
  finalizedSnapshot   ManufacturingCostSnapshot?   @relation(fields: [finalizedSnapshotId], references: [id], onDelete: SetNull)
  createdBy           User                         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, orderId, transactionDate])
  @@index([orderId, finalizedSnapshotId])
  @@index([costDriverId])
  @@index([wipAccountId])
  @@index([clearingAccountId])
}

/// Audit detail for each finished-goods receipt movement re-costed by an
/// actual-cost finalization. It preserves the before/after values independently
/// of later moving-average replays.
model ManufacturingCostAllocation {
  id               String                     @id @default(uuid())
  workspaceId      String
  costSnapshotId   String
  stockMovementId  String
  inventoryLotId   String?
  quantity         Decimal                    @db.Decimal(18, 6)
  previousUnitCost Decimal                    @db.Decimal(24, 8)
  revisedUnitCost  Decimal                    @db.Decimal(24, 8)
  allocatedAmount  Decimal                    @db.Decimal(24, 6)
  createdAt        DateTime                   @default(now())
  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  costSnapshot     ManufacturingCostSnapshot  @relation(fields: [costSnapshotId], references: [id], onDelete: Cascade)
  stockMovement    StockMovement              @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  inventoryLot     ManufacturingInventoryLot? @relation(fields: [inventoryLotId], references: [id], onDelete: SetNull)

  @@unique([costSnapshotId, stockMovementId])
  @@index([workspaceId, stockMovementId])
  @@index([inventoryLotId])
}

