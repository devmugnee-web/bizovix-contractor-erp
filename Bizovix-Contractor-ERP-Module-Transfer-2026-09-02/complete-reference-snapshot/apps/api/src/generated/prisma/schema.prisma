  DRAFT
  PLANNED
  PENDING_APPROVAL
  APPROVED
  MATERIAL_QC_PENDING
  MATERIAL_READY
  RESERVED
  STAGED
  ISSUED
  IN_PRODUCTION
  PRODUCTION_COMPLETE
  QC_PENDING
  QC_PASSED
  PACKAGING
  PACKAGING_RECONCILED
  FG_Q
  RELEASE_READY
  FG_R
  COST_FINALIZED
  CLOSED
  PERIOD_LOCKED
  CANCELLED
  ON_HOLD
}

enum ManufacturingEvidenceVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model ManufacturingWorkflowDefinition {
  id            String                                @id @default(uuid())
  version       Int                                   @unique
  isActive      Boolean                               @default(false)
  effectiveFrom DateTime                              @db.Date
  totalGroups   Int                                   @default(11)
  totalSteps    Int                                   @default(159)
  createdAt     DateTime                              @default(now())
  updatedAt     DateTime                              @updatedAt
  groups        ManufacturingWorkflowGroup[]
  steps         ManufacturingWorkflowStepDefinition[]
  runs          ManufacturingRun[]

  @@index([isActive, effectiveFrom])
}

model ManufacturingWorkflowGroup {
  id                   String                                @id @default(uuid())
  workflowDefinitionId String
  legacyGroupCode      String
  flowGroupCode        String
  name                 String
  flowGroupOrder       Int
  expectedStepCount    Int
  createdAt            DateTime                              @default(now())
  updatedAt            DateTime                              @updatedAt
  workflowDefinition   ManufacturingWorkflowDefinition       @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  steps                ManufacturingWorkflowStepDefinition[]

  @@unique([workflowDefinitionId, legacyGroupCode])
  @@unique([workflowDefinitionId, flowGroupCode])
  @@unique([workflowDefinitionId, flowGroupOrder])
}

model ManufacturingWorkflowStepDefinition {
  id                   String                                 @id @default(uuid())
  workflowDefinitionId String
  workflowGroupId      String
  legacyStepCode       String
  flowSerial           Int
  title                String
  displayOrder         Int
  executionOrder       Int
  stepType             ManufacturingWorkflowStepType
  applicabilityType    ManufacturingWorkflowApplicabilityType
  repeatable           Boolean                                @default(false)
  postingEffect        ManufacturingWorkflowPostingEffect     @default(NONE)
  idempotencyPolicy    ManufacturingWorkflowIdempotencyPolicy @default(NOT_APPLICABLE)
  route                String
  permissionKey        String
  completionRule       Json
  allowedModes         String[]
  isBlocking           Boolean                                @default(true)
  isActive             Boolean                                @default(true)
  createdAt            DateTime                               @default(now())
  updatedAt            DateTime                               @updatedAt
  workflowDefinition   ManufacturingWorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  workflowGroup        ManufacturingWorkflowGroup             @relation(fields: [workflowGroupId], references: [id], onDelete: Restrict)
  dependencies         ManufacturingStepDependency[]          @relation("ManufacturingStepDependencyStep")
  prerequisiteFor      ManufacturingStepDependency[]          @relation("ManufacturingStepDependencyPrerequisite")
  runSteps             ManufacturingRunStep[]
  evidence             ManufacturingEvidence[]

  @@unique([workflowDefinitionId, legacyStepCode])
  @@unique([workflowDefinitionId, flowSerial])
  @@unique([workflowDefinitionId, route])
  @@unique([workflowGroupId, displayOrder])
  @@index([workflowDefinitionId, executionOrder, isActive])
  @@index([workflowGroupId, applicabilityType])
}

model ManufacturingStepDependency {
  id                  String                              @id @default(uuid())
  stepId              String
  prerequisiteStepId  String
  requiredStatus      ManufacturingWorkflowStepStatus
  dependencyType      ManufacturingWorkflowDependencyType @default(HARD)
  conditionExpression Json?
  createdAt           DateTime                            @default(now())
  step                ManufacturingWorkflowStepDefinition @relation("ManufacturingStepDependencyStep", fields: [stepId], references: [id], onDelete: Restrict)
  prerequisiteStep    ManufacturingWorkflowStepDefinition @relation("ManufacturingStepDependencyPrerequisite", fields: [prerequisiteStepId], references: [id], onDelete: Restrict)

  @@unique([stepId, prerequisiteStepId, dependencyType])
  @@index([prerequisiteStepId])
}

model ManufacturingRun {
  id                   String                          @id @default(uuid())
  tenantId             String
  companyId            String
  workspaceId          String
  workflowDefinitionId String
  productionPlanId     String?
  productionOrderId    String?
  productId            String?
  manufacturingMode    ManufacturingMode
  status               ManufacturingRunStatus          @default(DRAFT)
  currentGroup         String?
  currentStepSerial    Int?
  version              Int                             @default(1)
  idempotencyKey       String
  startedAt            DateTime                        @default(now())
  completedAt          DateTime?
  closedAt             DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  tenant               Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company              Company                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workspace            Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  workflowDefinition   ManufacturingWorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  productionPlan       ManufacturingPlan?              @relation(fields: [productionPlanId], references: [id], onDelete: Restrict)
  productionOrder      ManufacturingOrder?             @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  product              InventoryItem?                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  steps                ManufacturingRunStep[]
  postingLinks         ManufacturingPostingLink[]
  evidence             ManufacturingEvidence[]

  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, productionOrderId])
  @@index([workspaceId, status, updatedAt])
  @@index([workflowDefinitionId, status])
  @@index([productionPlanId])
  @@index([productId])
}

model ManufacturingRunStep {
  id                 String                              @id @default(uuid())
  runId              String
  stepDefinitionId   String
  occurrenceKey      String                              @default("PRIMARY")
  status             ManufacturingWorkflowStepStatus     @default(READY)
  applicable         Boolean                             @default(true)
  blockerReason      String?
  naReason           String?
  sourceRecordType   String?
  sourceRecordId     String?
  startedAt          DateTime?
  completedAt        DateTime?
  completedBy        String?
  approvedBy         String?
  signatureReference String?
  version            Int                                 @default(1)
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt
  run                ManufacturingRun                    @relation(fields: [runId], references: [id], onDelete: Restrict)
  stepDefinition     ManufacturingWorkflowStepDefinition @relation(fields: [stepDefinitionId], references: [id], onDelete: Restrict)
  transitions        ManufacturingRunStepTransition[]
  evidence           ManufacturingEvidence[]

  @@unique([runId, stepDefinitionId, occurrenceKey])
  @@index([runId, status, applicable])
  @@index([stepDefinitionId, status])
  @@index([sourceRecordType, sourceRecordId])
}

model ManufacturingRunStepTransition {
  id                 String                          @id @default(uuid())
  runStepId          String
  fromStatus         ManufacturingWorkflowStepStatus
  toStatus           ManufacturingWorkflowStepStatus
  sourceAction       String
  reason             String?
  performedByUserId  String
  sourceRecordType   String?
  sourceRecordId     String?
  signatureReference String?
  idempotencyKey     String
  createdAt          DateTime                        @default(now())
  runStep            ManufacturingRunStep            @relation(fields: [runStepId], references: [id], onDelete: Restrict)

  @@unique([runStepId, idempotencyKey])
  @@index([runStepId, createdAt])
  @@index([performedByUserId, createdAt])
  @@index([sourceRecordType, sourceRecordId])
}

model ManufacturingPostingLink {
  id                 String                     @id @default(uuid())
  tenantId           String
  companyId          String
  workspaceId        String
  runId              String?
  sourceDocumentType String
  sourceDocumentId   String
  postingType        String
  idempotencyKey     String
  stockMovementId    String?
  journalId          String?
  postedAt           DateTime                   @default(now())
  reversedById       String?
  createdAt          DateTime                   @default(now())
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  run                ManufacturingRun?          @relation(fields: [runId], references: [id], onDelete: Restrict)
  stockMovement      StockMovement?             @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  journal            VoucherEntry?              @relation(fields: [journalId], references: [id], onDelete: Restrict)
  reversedBy         ManufacturingPostingLink?  @relation("ManufacturingPostingLinkReversal", fields: [reversedById], references: [id], onDelete: Restrict)
  reverses           ManufacturingPostingLink[] @relation("ManufacturingPostingLinkReversal")

  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, sourceDocumentType, sourceDocumentId, postingType])
  @@index([workspaceId, runId, postedAt])
  @@index([stockMovementId])
  @@index([journalId])
  @@index([reversedById])
}

model ManufacturingEvidence {
  id                 String                                  @id @default(uuid())
  tenantId           String
  companyId          String
  workspaceId        String
  runId              String
  runStepId          String?
  stepDefinitionId   String
  fileReference      String
  verifiedMimeType   String
  verifiedFileSize   Int
  sha256Checksum     String
  uploadedBy         String
  verifiedBy         String?
  verificationStatus ManufacturingEvidenceVerificationStatus @default(PENDING)
  createdAt          DateTime                                @default(now())
  verifiedAt         DateTime?
  tenant             Tenant                                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company            Company                                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workspace          Workspace                               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  run                ManufacturingRun                        @relation(fields: [runId], references: [id], onDelete: Restrict)
  runStep            ManufacturingRunStep?                   @relation(fields: [runStepId], references: [id], onDelete: Restrict)
  stepDefinition     ManufacturingWorkflowStepDefinition     @relation(fields: [stepDefinitionId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, runId, stepDefinitionId, sha256Checksum])
  @@index([runId, runStepId])
  @@index([workspaceId, verificationStatus, createdAt])
  @@index([sha256Checksum])
}
