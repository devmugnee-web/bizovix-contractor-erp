model ManufacturingSettings {
  id                                      String            @id @default(uuid())
  tenantId                                String
  companyId                               String
  workspaceId                             String            @unique
  mode                                    ManufacturingMode @default(GENERAL)
  currency                                String            @default("BDT")
  quantityScale                           Int               @default(4)
  costScale                               Int               @default(6)
  blockNegativeStock                      Boolean           @default(true)
  reservationRequired                     Boolean           @default(true)
  issueBeforeOperationStart               Boolean           @default(true)
  allowPartialCompletion                  Boolean           @default(true)
  allowProvisionalCost                    Boolean           @default(true)
  requireQcBeforeRelease                  Boolean           @default(true)
  requireSerialBeforeRelease              Boolean           @default(false)
  electronicSignatureRequired             Boolean           @default(true)
  approvalRequired                        Boolean           @default(true)
  defaultRawMaterialWarehouseId           String?
  defaultWipWarehouseId                   String?
  defaultFinishedGoodsWarehouseId         String?
  defaultFinishedGoodsReleasedWarehouseId String?
  defaultRejectedWarehouseId              String?
  defaultScrapWarehouseId                 String?
  defaultRawMaterialLocationId            String?
  defaultWipLocationId                    String?
  defaultFinishedGoodsHoldLocationId      String?
  defaultFinishedGoodsReleaseLocationId   String?
  rawMaterialInventoryAccountId           String?
  packagingInventoryAccountId             String?
  wipInventoryAccountId                   String?
  finishedGoodsInventoryAccountId         String?
  manufacturingVarianceAccountId          String?
  labourClearingAccountId                 String?
  overheadAbsorptionAccountId             String?
  scrapRecoveryAccountId                  String?
  updatedByUserId                         String?
  createdAt                               DateTime          @default(now())
  updatedAt                               DateTime          @updatedAt
  tenant                                  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                                 Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace                               Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId])
}

model ManufacturingItemProfile {
  id                       String                 @id @default(uuid())
  tenantId                 String
  companyId                String
  workspaceId              String
  inventoryItemId          String                 @unique
  role                     ManufacturingItemRole
  makeBuy                  ManufacturingMakeBuy   @default(BUY)
  lotTracked               Boolean                @default(false)
  serialTracked            Boolean                @default(false)
  expiryTracked            Boolean                @default(false)
  qcRequired               Boolean                @default(false)
  shelfLifeDays            Int?
  standardYieldPercent     Decimal                @default(100) @db.Decimal(9, 6)
  defaultIssueLocationId   String?
  defaultReceiptLocationId String?
  isActive                 Boolean                @default(true)
  createdByUserId          String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                  Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace                Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
