DATABASE_URL="postgresql://bizovix:YOUR_LOCAL_PASSWORD@localhost:5432/bizovix_contractor_erp_db"

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

VENDOR_ADMIN_JWT_SECRET=
VENDOR_ADMIN_JWT_EXPIRES_IN=12h

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
DEV_AUTH_BYPASS=false
DEV_AUTH_BYPASS_EMAIL=admin@bizovix.com
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

APP_NAME=Bizovix Contractor ERP
APP_ENV=development
APP_PORT=4000

# Optional desktop category pilot; enable only after its additive cloud migration.
# These are server settings. The signing private key must never enter an installer.
DESKTOP_SYNC_ENABLED=false
DESKTOP_SYNC_ISSUER=
DESKTOP_SYNC_PRIVATE_KEY_PEM=
DESKTOP_SYNC_OFFLINE_HOURS=24
